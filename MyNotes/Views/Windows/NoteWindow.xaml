<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="MyNotes.Views.Windows.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:MyNotes.Views.Windows"
        xmlns:helpers="using:MyNotes.Helpers"
        xmlns:tmpls="using:MyNotes.Templates"
        xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
        xmlns:ui="using:CommunityToolkit.WinUI"
        Title="{x:Bind ViewModel.Note.Title, Mode=OneWay}">

  <UserControl x:Name="NoteWindow_RootControl">
    <UserControl.Resources>
      <Style x:Key="DefaultThemeFlyoutPresenterStyle"
             TargetType="FlyoutPresenter"
             BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
        <Setter Property="RequestedTheme"
                Value="Default" />
      </Style>
      <Style x:Key="LightThemeFlyoutPresenterStyle"
             TargetType="FlyoutPresenter"
             BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
        <Setter Property="RequestedTheme"
                Value="Light" />
      </Style>
      <Style x:Key="DarkThemeFlyoutPresenterStyle"
             TargetType="FlyoutPresenter"
             BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
        <Setter Property="RequestedTheme"
                Value="Dark" />
      </Style>
      <Style x:Key="DefaultThemeMenuFlyoutPresenterStyle"
             TargetType="MenuFlyoutPresenter"
             BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
        <Setter Property="RequestedTheme"
                Value="Default" />
      </Style>
      <Style x:Key="LightThemeMenuFlyoutPresenterStyle"
             TargetType="MenuFlyoutPresenter"
             BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
        <Setter Property="RequestedTheme"
                Value="Light" />
      </Style>
      <Style x:Key="DarkThemeMenuFlyoutPresenterStyle"
             TargetType="MenuFlyoutPresenter"
             BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
        <Setter Property="RequestedTheme"
                Value="Dark" />
        <Setter Property="Background"
                Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />

      </Style>
    </UserControl.Resources>
    <Grid Background="{x:Bind helpers:ColorHelper.ToBrush(ViewModel.Note.Background), Mode=OneWay}"
          KeyboardAcceleratorPlacementMode="Hidden">
      <Grid.KeyboardAccelerators>
        <KeyboardAccelerator x:Name="NoteWindow_SaveKeyboardAccelerator"
                             Modifiers="Control"
                             Key="S"
                             Invoked="NoteWindow_SaveKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator x:Name="NoteWindow_FindKeyboardAccelerator"
                             Modifiers="Control"
                             Key="F"
                             Invoked="NoteWindow_SaveKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator x:Name="NoteWindow_ReplaceKeyboardAccelerator"
                             Modifiers="Control"
                             Key="H"
                             Invoked="NoteWindow_SaveKeyboardAccelerator_Invoked" />
      </Grid.KeyboardAccelerators>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!--#region Title Bar -->
      <Grid x:Name="NoteWindow_TitleBarGrid"
            Grid.Row="0"
            Height="40">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="PinButtonColumn"
                            Width="Auto" />
          <ColumnDefinition x:Name="MoreButtonColumn"
                            Width="Auto" />
          <ColumnDefinition x:Name="TitleColumn" />
          <ColumnDefinition x:Name="MinimizeButtonColumn"
                            Width="Auto" />
          <ColumnDefinition x:Name="CloseButtonColumn"
                            Width="Auto" />
        </Grid.ColumnDefinitions>

        <tmpls:SubtleIconButton x:Name="NoteWindow_PinButton"
                                Grid.Column="0"
                                Icon="{ui:FontIcon Glyph=&#xEE49;}"
                                Click="NoteWindow_PinButton_Click">
          <tmpls:SubtleIconButton.RenderTransform>
            <TranslateTransform x:Name="NoteWindow_PinButton_TranslateTransform" />
          </tmpls:SubtleIconButton.RenderTransform>
          <tmpls:SubtleIconButton.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control,Shift"
                                 Key="P" />
          </tmpls:SubtleIconButton.KeyboardAccelerators>
        </tmpls:SubtleIconButton>
        <tmpls:SubtleIconButton x:Name="NoteWindow_MoreButton"
                                Grid.Column="1"
                                Icon="{ui:FontIcon Glyph=&#xE712;}">
          <tmpls:SubtleIconButton.RenderTransform>
            <TranslateTransform x:Name="NoteWindow_MoreButton_TranslateTransform" />
          </tmpls:SubtleIconButton.RenderTransform>
          <tmpls:SubtleIconButton.Flyout>
            <MenuFlyout x:Name="NoteWindow_MoreButtonMenuFlyout"
                        Placement="RightEdgeAlignedTop"
                        ShouldConstrainToRootBounds="False"
                        MenuFlyoutPresenterStyle="{StaticResource DefaultThemeMenuFlyoutPresenterStyle}">
              <MenuFlyoutItem Text="New note"
                              Icon="Add" />
              <MenuFlyoutItem Text="View list"
                              Icon="{ui:FontIcon Glyph=&#xE71D;}" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem Text="Rename"
                              Icon="Rename" />
              <MenuFlyoutItem Text="Edit tags"
                              Icon="Tag" />
              <MenuFlyoutItem Text="Bookmark"
                              Icon="Favorite" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem Text="View mode"
                              Icon="View" />
              <MenuFlyoutSeparator />
              <MenuFlyoutSubItem Text="Save as"
                                 Icon="Save">
                <MenuFlyoutItem Text="Plain text (*.txt)" />
                <MenuFlyoutItem Text="Rich text (*.rtf)" />
                <MenuFlyoutItem Text="PDF (*.pdf)" />
              </MenuFlyoutSubItem>
              <MenuFlyoutItem Text="Share"
                              Icon="Share" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem Text="Delete"
                              Icon="Delete"
                              Style="{StaticResource EmphasisCriticalMenuFlyoutItemStyle}" />
            </MenuFlyout>
          </tmpls:SubtleIconButton.Flyout>
        </tmpls:SubtleIconButton>
        <TextBlock x:Name="NoteWindow_TitleTextBlock"
                   Grid.Column="2"
                   Text="{x:Bind ViewModel.Note.Title, Mode=OneWay}" />
        <tmpls:SubtleIconButton x:Name="NoteWindow_MinimizeButton"
                                Grid.Column="3"
                                Icon="{ui:FontIcon Glyph=&#xE738;}"
                                Click="NoteWindow_MinimizeButton_Click">
          <tmpls:SubtleIconButton.RenderTransform>
            <TranslateTransform x:Name="NoteWindow_MinimizeButton_TranslateTransform" />
          </tmpls:SubtleIconButton.RenderTransform>
        </tmpls:SubtleIconButton>
        <tmpls:SubtleIconButton x:Name="NoteWindow_CloseButton"
                                Grid.Column="4"
                                Icon="{ui:FontIcon Glyph=&#xE711;}"
                                Click="NoteWindow_CloseButton_Click">
          <tmpls:SubtleIconButton.RenderTransform>
            <TranslateTransform x:Name="NoteWindow_CloseButton_TranslateTransform" />
          </tmpls:SubtleIconButton.RenderTransform>
        </tmpls:SubtleIconButton>
      </Grid>
      <!--#endregion -->

      <!--#region Text Editor -->
      <Border Grid.Row="1">
        <Border.Resources>
          <SolidColorBrush x:Key="TextControlBorderBrush"
                           Color="{StaticResource ControlFillColorTransparent}" />
          <SolidColorBrush x:Key="TextControlBackground"
                           Color="{StaticResource ControlFillColorTransparent}" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver"
                           Color="{StaticResource ControlFillColorTransparent}" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver"
                           Color="{StaticResource ControlFillColorTransparent}" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused"
                           Color="{StaticResource ControlFillColorTransparent}" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused"
                           Color="{StaticResource ControlFillColorTransparent}" />
        </Border.Resources>
        <RichEditBox x:Name="NoteWindow_TextEditorRichEditBox"
                     SelectionFlyout="{x:Null}"
                     SelectionHighlightColorWhenNotFocused="{StaticResource AccentFillColorSelectedTextBackgroundBrush}"
                     MaxLength="100000"
                     IsSpellCheckEnabled="False" />
      </Border>
      <!--#endregion -->

      <!--#region Command Bar -->
      <ScrollViewer x:Name="NoteWindow_CommandBarScrollViewer"
                    Grid.Row="2"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollMode="Disabled"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Disabled">
        <ScrollViewer.RenderTransform>
          <TranslateTransform x:Name="NoteWindow_CommandBarScrollViewer_TranslateTransform" />
        </ScrollViewer.RenderTransform>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">
          <tmpls:SubtleIconToggleButton x:Name="NoteWindow_BoldButton"
                                        Icon="{ui:FontIcon Glyph=&#xE8DD;}"
                                        Click="NoteWindow_BoldButton_Click" />
          <tmpls:SubtleIconButton x:Name="NoteWindow_ItalicButton"
                                  Icon="{ui:FontIcon Glyph=&#xE8DB;}"
                                  Click="NoteWindow_ItalicButton_Click" />
          <tmpls:SubtleIconButton x:Name="NoteWindow_UnderlineButton"
                                  Icon="{ui:FontIcon Glyph=&#xE8DC;}"
                                  Click="NoteWindow_UnderlineButton_Click" />
          <tmpls:SubtleIconButton x:Name="NoteWindow_StrikethroughButton"
                                  Icon="{ui:FontIcon Glyph=&#xEDE0;}"
                                  Click="NoteWindow_StrikethroughButton_Click">
            <tmpls:SubtleIconButton.KeyboardAccelerators>
              <KeyboardAccelerator Modifiers="Control"
                                   Key="T" />
            </tmpls:SubtleIconButton.KeyboardAccelerators>
          </tmpls:SubtleIconButton>
          <tmpls:SubtleIconButton x:Name="NoteWindow_MarkerButton"
                                  Icon="{ui:FontIcon Glyph=&#xF2C7;}" />
          <tmpls:SubtleIconButton x:Name="NoteWindow_FontSizeButton"
                                  Icon="{ui:FontIcon Glyph=&#xE8E9;}" />
          <tmpls:SubtleIconButton x:Name="NoteWindow_FontColorButton"
                                  Icon="{ui:FontIcon Glyph=&#xE8D3;}" />
          <tmpls:SubtleIconButton x:Name="NoteWindow_HighlightButton"
                                  Icon="{ui:FontIcon Glyph=&#xE7E6;}">
            <tmpls:SubtleIconButton.KeyboardAccelerators>
              <KeyboardAccelerator Modifiers="Control,Shift"
                                   Key="H" />
            </tmpls:SubtleIconButton.KeyboardAccelerators>
          </tmpls:SubtleIconButton>
          <tmpls:SubtleIconButton x:Name="NoteWindow_BackgroundColorButton"
                                  Icon="{ui:FontIcon Glyph=&#xE790;}">
            <tmpls:SubtleIconButton.Flyout>
              <Flyout x:Name="NoteWindow_BackgroundColorFlyout"
                      Placement="Top"
                      ShouldConstrainToRootBounds="False"
                      FlyoutPresenterStyle="{StaticResource DefaultThemeFlyoutPresenterStyle}">
                <StackPanel Spacing="12">
                  <RadioButtons MaxColumns="3"
                                Header="Backdrop"
                                HeaderTemplate="{StaticResource ControlTextHeaderTemplate}">
                    <RadioButton Content="None"
                                 MinWidth="100" />
                    <RadioButton Content="Acrylic"
                                 MinWidth="100" />
                    <RadioButton Content="Mica"
                                 MinWidth="100" />
                  </RadioButtons>

                  <NavigationViewItemSeparator />

                  <TextBlock Text="Background"
                             Style="{StaticResource BodyStrongTextBlockStyle}" />
                  <ColorPicker x:Name="NoteWindow_BackgroundColorPicker"
                               IsAlphaEnabled="True"
                               ColorSpectrumShape="Ring"
                               IsMoreButtonVisible="True"
                               Color="{x:Bind ViewModel.Note.Background, Mode=TwoWay}"
                               ColorChanged="NoteWindow_BackgroundColorPicker_ColorChanged" />
                </StackPanel>
              </Flyout>
            </tmpls:SubtleIconButton.Flyout>
          </tmpls:SubtleIconButton>
          <tmpls:SubtleIconButton x:Name="NoteWindow_ImageButton"
                                  Icon="{ui:FontIcon Glyph=&#xE91B;}" />
        </StackPanel>
      </ScrollViewer>
      <!--#endregion -->

      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="FlyoutThemeStates">
          <VisualState x:Name="FlyoutThemeDefault" />
          <VisualState x:Name="FlyoutThemeLight">
            <VisualState.Setters>
              <Setter Target="NoteWindow_BackgroundColorFlyout.FlyoutPresenterStyle"
                      Value="{StaticResource LightThemeFlyoutPresenterStyle}" />
              <Setter Target="NoteWindow_MoreButtonMenuFlyout.MenuFlyoutPresenterStyle"
                      Value="{StaticResource LightThemeMenuFlyoutPresenterStyle}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="FlyoutThemeDark">
            <VisualState.Setters>
              <Setter Target="NoteWindow_BackgroundColorFlyout.FlyoutPresenterStyle"
                      Value="{StaticResource DarkThemeFlyoutPresenterStyle}" />
              <Setter Target="NoteWindow_MoreButtonMenuFlyout.MenuFlyoutPresenterStyle"
                      Value="{StaticResource DarkThemeMenuFlyoutPresenterStyle}" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>

        <VisualStateGroup x:Name="WindowActivationStates">
          <VisualState x:Name="WindowActivated">
            <Storyboard>
              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NoteWindow_CommandBarScrollViewer"
                                             Storyboard.TargetProperty="Visibility">
                <DiscreteObjectKeyFrame KeyTime="0:0:0.1"
                                        Value="Visible" />
              </ObjectAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteWindow_CommandBarScrollViewer"
                                             Storyboard.TargetProperty="Opacity"
                                             BeginTime="0:0:0.1">
                <SplineDoubleKeyFrame KeyTime="0:0:0.15"
                                      KeySpline="0.2,0.7 0.5,1.0"
                                      Value="1" />
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteWindow_CommandBarScrollViewer_TranslateTransform"
                                             Storyboard.TargetProperty="Y"
                                             BeginTime="0:0:0.1">
                <SplineDoubleKeyFrame KeyTime="0:0:0.15"
                                      KeySpline="0.2,0.7 0.5,1.0"
                                      Value="0" />
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteWindow_PinButton"
                                             Storyboard.TargetProperty="Opacity"
                                             BeginTime="0:0:0.1">
                <SplineDoubleKeyFrame KeyTime="0:0:0.15"
                                      KeySpline="0.2,0.7 0.5,1.0"
                                      Value="1" />
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteWindow_PinButton_TranslateTransform"
                                             Storyboard.TargetProperty="Y"
                                             BeginTime="0:0:0.1">
                <SplineDoubleKeyFrame KeyTime="0:0:0.15"
                                      KeySpline="0.2,0.7 0.5,1.0"
                                      Value="0" />
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteWindow_MoreButton"
                                             Storyboard.TargetProperty="Opacity"
                                             BeginTime="0:0:0.1">
                <SplineDoubleKeyFrame KeyTime="0:0:0.15"
                                      KeySpline="0.2,0.7 0.5,1.0"
                                      Value="1" />
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteWindow_MoreButton_TranslateTransform"
                                             Storyboard.TargetProperty="Y"
                                             BeginTime="0:0:0.1">
                <SplineDoubleKeyFrame KeyTime="0:0:0.15"
                                      KeySpline="0.2,0.7 0.5,1.0"
                                      Value="0" />
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteWindow_MinimizeButton"
                                             Storyboard.TargetProperty="Opacity"
                                             BeginTime="0:0:0.1">
                <SplineDoubleKeyFrame KeyTime="0:0:0.15"
                                      KeySpline="0.2,0.7 0.5,1.0"
                                      Value="1" />
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteWindow_MinimizeButton_TranslateTransform"
                                             Storyboard.TargetProperty="Y"
                                             BeginTime="0:0:0.1">
                <SplineDoubleKeyFrame KeyTime="0:0:0.15"
                                      KeySpline="0.2,0.7 0.5,1.0"
                                      Value="0" />
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteWindow_CloseButton"
                                             Storyboard.TargetProperty="Opacity"
                                             BeginTime="0:0:0.1">
                <SplineDoubleKeyFrame KeyTime="0:0:0.15"
                                      KeySpline="0.2,0.7 0.5,1.0"
                                      Value="1" />
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteWindow_CloseButton_TranslateTransform"
                                             Storyboard.TargetProperty="Y"
                                             BeginTime="0:0:0.1">
                <SplineDoubleKeyFrame KeyTime="0:0:0.15"
                                      KeySpline="0.2,0.7 0.5,1.0"
                                      Value="0" />
              </DoubleAnimationUsingKeyFrames>
            </Storyboard>
          </VisualState>

          <VisualState x:Name="WindowDeactivated">
            <Storyboard>
              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NoteWindow_CommandBarScrollViewer"
                                             Storyboard.TargetProperty="Visibility">
                <DiscreteObjectKeyFrame KeyTime="0"
                                        Value="Collapsed" />
              </ObjectAnimationUsingKeyFrames>
              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NoteWindow_CommandBarScrollViewer"
                                             Storyboard.TargetProperty="Opacity">
                <DiscreteObjectKeyFrame KeyTime="0"
                                        Value="0" />
              </ObjectAnimationUsingKeyFrames>
              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NoteWindow_CommandBarScrollViewer_TranslateTransform"
                                             Storyboard.TargetProperty="Y">
                <DiscreteObjectKeyFrame KeyTime="0"
                                        Value="40" />
              </ObjectAnimationUsingKeyFrames>
              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NoteWindow_PinButton"
                                             Storyboard.TargetProperty="Opacity">
                <DiscreteObjectKeyFrame KeyTime="0"
                                        Value="0" />
              </ObjectAnimationUsingKeyFrames>
              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NoteWindow_PinButton_TranslateTransform"
                                             Storyboard.TargetProperty="Y">
                <DiscreteObjectKeyFrame KeyTime="0"
                                        Value="-40" />
              </ObjectAnimationUsingKeyFrames>
              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NoteWindow_MoreButton"
                                             Storyboard.TargetProperty="Opacity">
                <DiscreteObjectKeyFrame KeyTime="0"
                                        Value="0" />
              </ObjectAnimationUsingKeyFrames>
              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NoteWindow_MoreButton_TranslateTransform"
                                             Storyboard.TargetProperty="Y">
                <DiscreteObjectKeyFrame KeyTime="0"
                                        Value="-40" />
              </ObjectAnimationUsingKeyFrames>
              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NoteWindow_MinimizeButton"
                                             Storyboard.TargetProperty="Opacity">
                <DiscreteObjectKeyFrame KeyTime="0"
                                        Value="0" />
              </ObjectAnimationUsingKeyFrames>
              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NoteWindow_MinimizeButton_TranslateTransform"
                                             Storyboard.TargetProperty="Y">
                <DiscreteObjectKeyFrame KeyTime="0"
                                        Value="-40" />
              </ObjectAnimationUsingKeyFrames>
              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NoteWindow_CloseButton"
                                             Storyboard.TargetProperty="Opacity">
                <DiscreteObjectKeyFrame KeyTime="0"
                                        Value="0" />
              </ObjectAnimationUsingKeyFrames>
              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NoteWindow_CloseButton_TranslateTransform"
                                             Storyboard.TargetProperty="Y">
                <DiscreteObjectKeyFrame KeyTime="0"
                                        Value="-40" />
              </ObjectAnimationUsingKeyFrames>
            </Storyboard>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    </Grid>
  </UserControl>
</Window>
