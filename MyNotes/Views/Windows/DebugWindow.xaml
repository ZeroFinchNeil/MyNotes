<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="MyNotes.Views.Windows.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:MyNotes.Views.Windows"
        Title="DebugWindow">

  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="DebugWindow_RootGrid"
        ColumnSpacing="4">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Grid Padding="12"
          Grid.Column="0"
          RowSpacing="12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
      </Grid.RowDefinitions>
      <ScrollViewer Grid.Row="0">
        <StackPanel Spacing="8">
          <Button x:Name="DebugWindow_MainWindowButton"
                  HorizontalAlignment="Center"
                  Content="Main window"
                  MinWidth="200"
                  Click="DebugWindow_MainWindowButton_Click" />

          <MenuFlyoutSeparator />

          <Button x:Name="DebugWindow_SeparatorButton"
                  HorizontalAlignment="Center"
                  Content="Separator"
                  MinWidth="200"
                  Click="DebugWindow_SeparatorButton_Click" />
          <MenuFlyoutSeparator />

          <Button x:Name="DebugWindow_GCButton"
                  HorizontalAlignment="Center"
                  Content="GC"
                  MinWidth="200"
                  Click="DebugWindow_GCButton_Click" />
          <Button x:Name="DebugWindow_ShowReferencesButton"
                  HorizontalAlignment="Center"
                  Content="Show references"
                  MinWidth="200"
                  Click="DebugWindow_ShowReferencesButton_Click"
                  Style="{StaticResource AccentButtonStyle}" />

          <MenuFlyoutSeparator />
          <ToggleButton x:Name="DebugWindow_AlwaysOnTopToggleButton"
                        HorizontalAlignment="Center"
                        Content="Always on top"
                        MinWidth="200"
                        Click="DebugWindow_AlwaysOnTopToggleButton_Click" />

          <MenuFlyoutSeparator />

          <ToggleButton x:Name="DebugWindow_TrackFocusedElementToggleButton"
                        HorizontalAlignment="Center"
                        Content="Track Focused Element"
                        MinWidth="200" />
          
          <developerTools:FocusTracker IsActive="{Binding ElementName=DebugWindow_TrackFocusedElementToggleButton, Path=IsChecked}"
                                       xmlns:developerTools="using:CommunityToolkit.WinUI.DeveloperTools" />
        </StackPanel>
      </ScrollViewer>

      <ListView x:Name="DebugWindow_ReferencePropertyInfosListView"
                Grid.Row="1"
                ScrollViewer.VerticalScrollMode="Enabled"
                ScrollViewer.VerticalScrollBarVisibility="Hidden"
                SelectionMode="None"
                ItemsSource="{x:Bind ReferencePropertyInfo}">
        <ListView.HeaderTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Text="{x:Bind}"
                       TextAlignment="Center"
                       FontWeight="SemiBold"
                       FontSize="16"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,0,4" />
          </DataTemplate>
        </ListView.HeaderTemplate>
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem"
                 BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight"
                    Value="24" />
            <Setter Property="VerticalContentAlignment"
                    Value="Stretch" />
            <Setter Property="Padding"
                    Value="0" />
          </Style>
        </ListView.ItemContainerStyle>

        <ListView.ItemTemplate>
          <DataTemplate x:DataType="local:DebugWindowReferenceItemPropertyInfo">
            <StackPanel Margin="0,2"
                        BorderBrush="{ThemeResource ControlStrokeColorSecondary}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Background="{ThemeResource ControlFillColorDefault}">
              <Border Background="{ThemeResource SubtleFillColorSecondary}"
                      ToolTipService.ToolTip="{x:Bind Value}">
                <TextBlock Text="{x:Bind Name}"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
              </Border>
              <TextBlock Text="{x:Bind Value}"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         IsTextSelectionEnabled="True"
                         MaxHeight="100"
                         FontWeight="SemiLight" 
                         TextLineBounds="TrimToCapHeight"
                         Margin="0,3,0,0"/>
            </StackPanel>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Grid>

    <Rectangle Grid.Column="1"
               Width="1"
               VerticalAlignment="Stretch"
               Stretch="Fill"
               Fill="{StaticResource ControlStrokeColorDefault}"
               Margin="0,12" />

    <ScrollViewer Grid.Column="2"
                  Padding="12"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollMode="Enabled"
                  VerticalScrollBarVisibility="Auto">
      <Grid RowSpacing="6">
        <Grid.Resources>
          <CollectionViewSource x:Name="DebugWindow_ReferenceCVS"
                                Source="{x:Bind GroupItems}"
                                IsSourceGrouped="True" />
        </Grid.Resources>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition />
        </Grid.RowDefinitions>

        <Border x:Name="DebugWindow_FocusedElementBorder"
                Grid.Row="0"
                Padding="6"
                CornerRadius="{StaticResource ControlCornerRadius}"
                BorderThickness="2"
                Visibility="{x:Bind DebugWindow_TrackFocusedElementToggleButton.IsChecked.Value, Mode=OneWay}">
          <TextBlock x:Name="DebugWindow_FocusedElementTextBlock"
                     IsTextSelectionEnabled="True" />
        </Border>

        <ListView x:Name="DebugWindow_ReferenceListView"
                  Grid.Row="1"
                  ItemsSource="{Binding Source={StaticResource DebugWindow_ReferenceCVS}}"
                  SelectionMode="None"
                  MinWidth="400">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem"
                   BasedOn="{StaticResource DefaultListViewItemStyle}">
              <Setter Property="MinHeight"
                      Value="24" />
              <Setter Property="VerticalContentAlignment"
                      Value="Stretch" />
              <Setter Property="Padding"
                      Value="8,0" />
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="local:DebugWindowReferenceItemGroup">
              <Grid ColumnSpacing="8"
                    Padding="6,0"
                    BorderBrush="{ThemeResource ControlStrokeColorDefault}"
                    BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition MinWidth="200"
                                    Width="Auto" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{x:Bind Type}"
                           IsTextSelectionEnabled="True"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <ItemsRepeater Grid.Column="1"
                               ItemsSource="{x:Bind Descriptions}"
                               Margin="0,2">
                  <ItemsRepeater.Layout>
                    <UniformGridLayout Orientation="Horizontal"
                                       ItemsStretch="Fill" />
                  </ItemsRepeater.Layout>

                  <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:DebugWindowReferenceItem">
                      <Button Content="{x:Bind HashCode}"
                              DataContext="{x:Bind}"
                              Click="DebugWindow_DescriptionButton_Click"
                              Style="{StaticResource SubtleButtonStyle}"
                              Padding="4,2" />
                    </DataTemplate>
                  </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
          <ListView.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Key}"
                             Style="{StaticResource HeaderTextBlockStyle}"
                             FontSize="20" />
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListView.GroupStyle>
        </ListView>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
