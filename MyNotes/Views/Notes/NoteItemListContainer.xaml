<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="MyNotes.Views.Notes.NoteItemListContainer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MyNotes.Views.Notes"
             xmlns:templates="using:MyNotes.Templates"
             xmlns:helpers="using:MyNotes.Common.Helpers"
             xmlns:interactivity="using:Microsoft.Xaml.Interactivity">

  <Grid x:Name="NoteItem_RootGrid"
        Background="{x:Bind helpers:ColorHelper.ToBrush(ViewModel.Note.BackgroundColor), Mode=OneWay}"
        CornerRadius="{ThemeResource OverlayCornerRadius}"
        BorderThickness="1"
        BorderBrush="{ThemeResource ControlStrokeColorDefault}"
        BackgroundSizing="InnerBorderEdge"
        Translation="0,0,12">
    <Grid.Shadow>
      <ThemeShadow />
    </Grid.Shadow>

    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"
                        MinWidth="100" 
                        MaxWidth="200"/>
      <ColumnDefinition Width="1" />
      <ColumnDefinition Width="4*" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Column="0"
               Padding="6,0"
               VerticalAlignment="Center"
               HorizontalTextAlignment="Center"
               Text="{x:Bind ViewModel.Note.Title, Mode=OneWay}"
               TextTrimming="CharacterEllipsis"
               TextWrapping="Wrap"
               Style="{StaticResource BodyStrongTextBlockStyle}">
      <interactivity:Interaction.Behaviors>
        <interactivity:EventTriggerBehavior EventName="DoubleTapped">
          <interactivity:InvokeCommandAction Command="{x:Bind ViewModel.OpenWindowCommand}"
                                             CommandParameter="{x:Bind ViewModel.Note}" />
        </interactivity:EventTriggerBehavior>
      </interactivity:Interaction.Behaviors>
    </TextBlock>

    <Rectangle Grid.Column="1"
               Stretch="Fill"
               Fill="{ThemeResource DividerStrokeColorDefault}" />
    <!-- Body -->
    <templates:ReadOnlyRichEditBox x:Name="NoteItem_PreviewRichEditBox"
                                   Grid.Column="2"
                                   RtfText="{x:Bind ViewModel.Note.Preview, Mode=OneWay}" />
    
    <Border x:Name="NoteItem_PreviewCoverBorder"
            Grid.Column="2"
            Background="Transparent">
      <interactivity:Interaction.Behaviors>
        <interactivity:EventTriggerBehavior EventName="DoubleTapped">
          <interactivity:InvokeCommandAction Command="{x:Bind ViewModel.OpenWindowCommand}"
                                             CommandParameter="{x:Bind ViewModel.Note}" />
        </interactivity:EventTriggerBehavior>
      </interactivity:Interaction.Behaviors>
    </Border>

  </Grid>
</UserControl>
