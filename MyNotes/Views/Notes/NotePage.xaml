<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="MyNotes.Views.Notes.NotePage"
      x:Name="NotePage_RootPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:sys="using:System"
      xmlns:local="using:MyNotes.Views.Notes"
      xmlns:notes="using:MyNotes.Models.Notes"
      xmlns:navigations="using:MyNotes.Models.Navigations"
      xmlns:helpers="using:MyNotes.Helpers"
      xmlns:commands="using:MyNotes.Common.Commands"
      xmlns:converters="using:MyNotes.Common.Converters"
      xmlns:tmpls="using:MyNotes.Templates"
      xmlns:ctw="using:CommunityToolkit.WinUI"
      xmlns:ctwc="using:CommunityToolkit.WinUI.Controls"
      xmlns:media="using:CommunityToolkit.WinUI.Media"
      xmlns:mxi="using:Microsoft.Xaml.Interactivity"
      RequestedTheme="{x:Bind helpers:ColorHelper.GetThemeFromColor(ViewModel.Note.BackgroundColor), Mode=OneWay}">

  <Page.Resources>
    <Style x:Key="DefaultThemeFlyoutPresenterStyle"
           TargetType="FlyoutPresenter"
           BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
      <Setter Property="RequestedTheme"
              Value="Default" />
    </Style>
    <Style x:Key="LightThemeFlyoutPresenterStyle"
           TargetType="FlyoutPresenter"
           BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
      <Setter Property="RequestedTheme"
              Value="Light" />
    </Style>
    <Style x:Key="DarkThemeFlyoutPresenterStyle"
           TargetType="FlyoutPresenter"
           BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
      <Setter Property="RequestedTheme"
              Value="Dark" />
    </Style>
    <Style x:Key="DefaultThemeMenuFlyoutPresenterStyle"
           TargetType="MenuFlyoutPresenter"
           BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
      <Setter Property="RequestedTheme"
              Value="Default" />
    </Style>
    <Style x:Key="LightThemeMenuFlyoutPresenterStyle"
           TargetType="MenuFlyoutPresenter"
           BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
      <Setter Property="RequestedTheme"
              Value="Light" />
    </Style>
    <Style x:Key="DarkThemeMenuFlyoutPresenterStyle"
           TargetType="MenuFlyoutPresenter"
           BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
      <Setter Property="RequestedTheme"
              Value="Dark" />
      <Setter Property="Background"
              Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />

    </Style>

    <converters:EnumToIntConverter x:Key="BackdropKindToIntConverter"
                                   EnumType="notes:BackdropKind" />
  </Page.Resources>
  <Grid Background="{x:Bind GetBackgroundBrush(ViewModel.Note.BackdropKind, ViewModel.Note.BackgroundColor), Mode=OneWay}"
        KeyboardAcceleratorPlacementMode="Hidden">
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator x:Name="NotePage_SaveKeyboardAccelerator"
                           Modifiers="Control"
                           Key="S"
                           Invoked="NotePage_SaveKeyboardAccelerator_Invoked" />
      <KeyboardAccelerator x:Name="NotePage_FindKeyboardAccelerator"
                           Modifiers="Control"
                           Key="F"
                           Invoked="NotePage_FindKeyboardAccelerator_Invoked" />
      <KeyboardAccelerator x:Name="NotePage_ReplaceKeyboardAccelerator"
                           Modifiers="Control"
                           Key="H"
                           Invoked="NotePage_ReplaceKeyboardAccelerator_Invoked" />
      <KeyboardAccelerator x:Name="NotePage_RenameTitleKeyboardAccelerator"
                           Key="F2"
                           Invoked="NotePage_RenameTitleKeyboardAccelerator_Invoked" />
    </Grid.KeyboardAccelerators>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0"
          Grid.RowSpan="3"
          Visibility="{x:Bind ViewModel.Note.IsBackgroundImageVisible, Mode=OneWay}">
      <Image Source="{x:Bind ViewModel.BackgroundImage, Mode=OneWay}"
             Stretch="Uniform"
             Opacity="{x:Bind ViewModel.Note.BackgroundImageOpacity, Mode=OneWay}" />
      <Border>
        <Border.Background>
          <media:BackdropBlurBrush Amount="{x:Bind ViewModel.Note.BackgroundImageBlur, Mode=OneWay}" />
        </Border.Background>
      </Border>
    </Grid>

    <!--#region Title Bar -->
    <Grid x:Name="NotePage_TitleBarGrid"
          Grid.Row="0"
          Height="40"
          Loaded="NotePage_TitleBarGrid_Loaded"
          SizeChanged="NotePage_TitleBarGrid_SizeChanged">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="PinButtonColumn"
                          Width="Auto" />
        <ColumnDefinition x:Name="MoreButtonColumn"
                          Width="Auto" />
        <ColumnDefinition x:Name="TitleColumn" />
        <ColumnDefinition x:Name="MinimizeButtonColumn"
                          Width="Auto" />
        <ColumnDefinition x:Name="CloseButtonColumn"
                          Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Pin Button -->
      <tmpls:AlternateSubtleIconToggleButton x:Name="NotePage_PinButton"
                                             x:Uid="/NotePage/PinButton"
                                             Grid.Column="0"
                                             IsChecked="{x:Bind ViewModel.Note.IsAlwaysOnTop, Mode=TwoWay}">
        <tmpls:AlternateSubtleIconToggleButton.Icon>
          <FontIcon Glyph="&#xE718;" />
        </tmpls:AlternateSubtleIconToggleButton.Icon>
        <tmpls:AlternateSubtleIconToggleButton.CheckedIcon>
          <Grid>
            <FontIcon Glyph="&#xE841;" />
            <FontIcon Glyph="&#xE718;" />
          </Grid>
        </tmpls:AlternateSubtleIconToggleButton.CheckedIcon>
        <tmpls:AlternateSubtleIconToggleButton.RenderTransform>
          <TranslateTransform x:Name="NotePage_PinButton_TranslateTransform" />
        </tmpls:AlternateSubtleIconToggleButton.RenderTransform>
        <tmpls:AlternateSubtleIconToggleButton.KeyboardAccelerators>
          <KeyboardAccelerator Modifiers="Control"
                               Key="P" />
        </tmpls:AlternateSubtleIconToggleButton.KeyboardAccelerators>
      </tmpls:AlternateSubtleIconToggleButton>

      <!--#region More Button -->
      <tmpls:SubtleIconButton x:Name="NotePage_MoreButton"
                              x:Uid="/NotePage/MoreButton"
                              Grid.Column="1"
                              Content="{ctw:FontIcon Glyph=&#xE712;}">
        <tmpls:SubtleIconButton.RenderTransform>
          <TranslateTransform x:Name="NotePage_MoreButton_TranslateTransform" />
        </tmpls:SubtleIconButton.RenderTransform>
        <tmpls:SubtleIconButton.Flyout>
          <MenuFlyout x:Name="NotePage_MoreButtonMenuFlyout"
                      Placement="RightEdgeAlignedTop"
                      ShouldConstrainToRootBounds="False"
                      MenuFlyoutPresenterStyle="{StaticResource DefaultThemeMenuFlyoutPresenterStyle}">
            <!-- Rename Title -->
            <MenuFlyoutItem x:Name="NotePage_RenameTitleMenuFlyoutItem"
                            x:Uid="/NotePage/RenameTitleMenuFlyoutItem"
                            Icon="Rename"
                            Click="NotePage_RenameTitleMenuFlyoutItem_Click">
              <MenuFlyoutItem.KeyboardAccelerators>
                <KeyboardAccelerator Key="F2" />
              </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>

            <MenuFlyoutSeparator />

            <!-- New Note -->
            <MenuFlyoutItem x:Uid="/NotePage/NewNoteMenuFlyoutItem"
                            Icon="Add"
                            Command="{x:Bind ViewModel.CreateNewNoteCommand}"
                            CommandParameter="{x:Null}" />

            <!-- View List -->
            <MenuFlyoutItem x:Uid="/NotePage/ViewListMenuFlyoutItem"
                            Icon="{ctw:FontIcon Glyph=&#xE71D;}"
                            Command="{x:Bind ViewModel.ViewListCommand}"
                            CommandParameter="{x:Bind ViewModel.Note}" />

            <MenuFlyoutSeparator />

            <!-- Edit Tags -->
            <MenuFlyoutItem x:Uid="/NotePage/EditTagsMenuFlyoutItem"
                            Icon="Tag" />

            <!-- Bookmark and Unbookmark -->
            <tmpls:AlternateMenuFlyoutItem x:Uid="/NotePage/BookmarkMenuFlyoutItem"
                                           Icon="Favorite"
                                           CheckedIcon="UnFavorite"
                                           IsChecked="{x:Bind ViewModel.Note.IsBookmarked, Mode=TwoWay}" />

            <!-- View Mode -->
            <MenuFlyoutSubItem x:Uid="/NotePage/ViewModeMenuFlyoutSubItem"
                               Icon="View">
              <RadioMenuFlyoutItem x:Uid="/NotePage/ViewModeEditMenuFlyoutItem"
                                   GroupName="ViewMode"
                                   IsChecked="True"
                                   Tag="Edit"
                                   Click="NotePage_ViewModeRadioMenuFlyoutItem_Click" />
              <RadioMenuFlyoutItem x:Uid="/NotePage/ViewModeReadOnlyMenuFlyoutItem"
                                   GroupName="ViewMode"
                                   Tag="ReadOnly"
                                   Click="NotePage_ViewModeRadioMenuFlyoutItem_Click" />
            </MenuFlyoutSubItem>

            <MenuFlyoutSeparator />

            <!-- Save As -->
            <MenuFlyoutSubItem x:Uid="/NotePage/SaveAsMenuFlyoutSubItem"
                               Icon="Save">
              <MenuFlyoutItem x:Uid="/NotePage/SaveAsPlainTextMenuFlyoutItem"
                              Tag="SaveAsPlainText"
                              Click="NotePage_SaveAsMenuFlyoutItem_Click" />
              <MenuFlyoutItem x:Uid="/NotePage/SaveAsRichTextMenuFlyoutItem"
                              Tag="SaveAsRichText"
                              Click="NotePage_SaveAsMenuFlyoutItem_Click" />
              <!--<MenuFlyoutItem Text="PDF (*.pdf)"
                              Tag="SaveAsPDF" />-->
            </MenuFlyoutSubItem>

            <!-- Share -->
            <MenuFlyoutItem x:Uid="/NotePage/ShareMenuFlyoutItem"
                            Icon="Share" />

            <MenuFlyoutSeparator />

            <!-- Delete Note -->
            <MenuFlyoutItem x:Uid="/NotePage/DeleteMenuFlyoutItem"
                            Icon="Delete"
                            Style="{StaticResource EmphasisCriticalMenuFlyoutItemStyle}" />
          </MenuFlyout>
        </tmpls:SubtleIconButton.Flyout>
      </tmpls:SubtleIconButton>
      <!--#endregion -->

      <!--#region Title -->
      <TextBlock x:Name="NotePage_TitleTextBlock"
                 Grid.Column="2"
                 Text="{x:Bind ViewModel.Note.Title, Mode=OneWay}"
                 Margin="4,0"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center"
                 TextTrimming="CharacterEllipsis"
                 TextWrapping="NoWrap"
                 Style="{StaticResource BodyStrongTextBlockStyle}" />

      <TextBox x:Name="NotePage_TitleRenameTextBox"
               Grid.Column="2"
               Text="{x:Bind ViewModel.Note.Title, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
               MinWidth="200"
               Visibility="Collapsed"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               LostFocus="NotePage_TitleRenameTextBox_LostFocus" />
      <!--#endregion -->

      <!--#region Caption Buttons -->
      <tmpls:SubtleIconButton x:Name="NotePage_MinimizeButton"
                              x:Uid="/NotePage/MinimizeButton"
                              Grid.Column="3"
                              Content="{ctw:FontIcon Glyph=&#xE738;}"
                              Click="NotePage_MinimizeButton_Click">
        <tmpls:SubtleIconButton.RenderTransform>
          <TranslateTransform x:Name="NotePage_MinimizeButton_TranslateTransform" />
        </tmpls:SubtleIconButton.RenderTransform>
      </tmpls:SubtleIconButton>
      <tmpls:SubtleIconButton x:Name="NotePage_CloseButton"
                              x:Uid="/NotePage/CloseButton"
                              Grid.Column="4"
                              Content="{ctw:FontIcon Glyph=&#xE711;}"
                              Click="NotePage_CloseButton_Click">
        <tmpls:SubtleIconButton.RenderTransform>
          <TranslateTransform x:Name="NotePage_CloseButton_TranslateTransform" />
        </tmpls:SubtleIconButton.RenderTransform>
      </tmpls:SubtleIconButton>
      <!--#endregion -->
    </Grid>
    <!--#endregion -->

    <!--#region Text Editor -->
    <Grid Grid.Row="1">
      <RichEditBox x:Name="NotePage_TextEditorRichEditBox"
                   RequestedTheme="Light"
                   SelectionFlyout="{x:Null}"
                   SelectionHighlightColorWhenNotFocused="{StaticResource AccentFillColorSelectedTextBackgroundBrush}"
                   MaxLength="100000"
                   IsSpellCheckEnabled="False"
                   TextWrapping="Wrap"
                   Paste="NotePage_TextEditorRichEditBox_Paste">
        <RichEditBox.Resources>
          <SolidColorBrush x:Key="TextControlBorderBrush"
                           Color="{StaticResource ControlFillColorTransparent}" />
          <SolidColorBrush x:Key="TextControlBackground"
                           Color="{StaticResource ControlFillColorTransparent}" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver"
                           Color="{StaticResource ControlFillColorTransparent}" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver"
                           Color="{StaticResource ControlFillColorTransparent}" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused"
                           Color="{StaticResource ControlFillColorTransparent}" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused"
                           Color="{StaticResource ControlFillColorTransparent}" />
        </RichEditBox.Resources>

        <mxi:Interaction.Behaviors>
          <mxi:EventTriggerBehavior EventName="SelectionChanged">
            <mxi:InvokeCommandAction Command="{x:Bind EditorViewModel.UpdateSelectionCommand}" />
          </mxi:EventTriggerBehavior>
          <mxi:EventTriggerBehavior EventName="TextChanging">
            <mxi:InvokeCommandAction Command="{x:Bind EditorViewModel.UpdateTextChangingCommand}" />
          </mxi:EventTriggerBehavior>
          <mxi:EventTriggerBehavior EventName="TextChanged">
            <mxi:InvokeCommandAction Command="{x:Bind EditorViewModel.UpdateTextChangedCommand}" />
          </mxi:EventTriggerBehavior>
        </mxi:Interaction.Behaviors>
      </RichEditBox>
    </Grid>
    <!--#endregion -->

    <!--#region Find and Replace -->
    <tmpls:FindReplaceBox x:Name="NotePage_FindReplaceBox"
                          Grid.Row="1"
                          VerticalAlignment="Top"
                          HorizontalAlignment="Right"
                          TargetEditor="{x:Bind NotePage_TextEditorRichEditBox}"
                          IsOpen="False"
                          RequestedTheme="{x:Bind NotePage_RootPage.RequestedTheme, Mode=OneTime}"
                          Margin="12" />
    <!--#endregion -->

    <!--#region Command Bar -->
    <ScrollViewer x:Name="NotePage_CommandBarScrollViewer"
                  Grid.Row="2"
                  HorizontalScrollMode="Enabled"
                  VerticalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Hidden"
                  VerticalScrollBarVisibility="Disabled">
      <ScrollViewer.RenderTransform>
        <TranslateTransform x:Name="NotePage_CommandBarScrollViewer_TranslateTransform" />
      </ScrollViewer.RenderTransform>

      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  Spacing="6"
                  Padding="6">
        <!-- Bold -->
        <tmpls:SubtleIconToggleButton x:Name="NotePage_BoldButton"
                                      x:Uid="/NotePage/BoldButton"
                                      Content="{ctw:FontIcon Glyph=&#xE8DD;}"
                                      AllowFocusOnInteraction="False"
                                      IsChecked="{x:Bind EditorViewModel.IsSelectionBold, Mode=TwoWay}" />

        <!-- Italic -->
        <tmpls:SubtleIconToggleButton x:Name="NotePage_ItalicButton"
                                      x:Uid="/NotePage/ItalicButton"
                                      Content="{ctw:FontIcon Glyph=&#xE8DB;}"
                                      AllowFocusOnInteraction="False"
                                      IsChecked="{x:Bind EditorViewModel.IsSelectionItalic, Mode=TwoWay}" />

        <!-- Underline -->
        <tmpls:SubtleIconToggleButton x:Name="NotePage_UnderlineButton"
                                      x:Uid="/NotePage/UnderlineButton"
                                      Content="{ctw:FontIcon Glyph=&#xE8DC;}"
                                      AllowFocusOnInteraction="False"
                                      IsChecked="{x:Bind EditorViewModel.IsSelectionUnderlined, Mode=TwoWay}" />

        <!-- Strikethrough -->
        <tmpls:SubtleIconToggleButton x:Name="NotePage_StrikethroughButton"
                                      x:Uid="/NotePage/StrikethroughButton"
                                      Content="{ctw:FontIcon Glyph=&#xEDE0;}"
                                      AllowFocusOnInteraction="False"
                                      IsChecked="{x:Bind EditorViewModel.IsSelectionStrikethrough, Mode=TwoWay}">
          <tmpls:SubtleIconToggleButton.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control"
                                 Key="T" />
          </tmpls:SubtleIconToggleButton.KeyboardAccelerators>
        </tmpls:SubtleIconToggleButton>

        <!-- Bullets and Numbering -->
        <tmpls:SubtleIconToggleSplitButton x:Name="NotePage_BulletsAndNumberingButton"
                                           x:Uid="/NotePage/BulletsAndNumberingButton"
                                           Content="{ctw:FontIcon Glyph=&#xE8BC;}"
                                           AllowFocusOnInteraction="False"
                                           IsChecked="{x:Bind EditorViewModel.IsSelectionParagraphList, Mode=TwoWay}">

          <tmpls:SubtleIconToggleSplitButton.Flyout>
            <Flyout Placement="Top"
                    ShouldConstrainToRootBounds="False">
              <StackPanel Spacing="12">
                <TextBlock x:Uid="/NotePage/MarkerTypeTextBlock"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <GridView ItemsSource="{x:Bind EditorViewModel.MarkerTypeMap.Rights}"
                          SelectedItem="{x:Bind EditorViewModel.SelectedMarkerType, Mode=TwoWay}"
                          Padding="0">
                  <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                      <ItemsWrapGrid Orientation="Horizontal"
                                     MaximumRowsOrColumns="5" />
                    </ItemsPanelTemplate>
                  </GridView.ItemsPanel>
                  <GridView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Border Width="40"
                              Height="40">
                        <TextBlock Text="{x:Bind}"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Padding="0,0,0,6"
                                   FontWeight="Light"
                                   FontSize="20" />
                      </Border>
                    </DataTemplate>
                  </GridView.ItemTemplate>
                </GridView>

                <NavigationViewItemSeparator />

                <TextBlock x:Uid="/NotePage/MarkerStyleTextBlock"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <GridView ItemsSource="{x:Bind EditorViewModel.MarkerStyleMap.Rights}"
                          SelectedItem="{x:Bind EditorViewModel.SelectedMarkerStyle, Mode=TwoWay}"
                          IsEnabled="{x:Bind EditorViewModel.IsSelectionMarkerStyleEnabled, Mode=OneWay}"
                          Padding="0">
                  <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                      <ItemsWrapGrid Orientation="Horizontal"
                                     MaximumRowsOrColumns="5" />
                    </ItemsPanelTemplate>
                  </GridView.ItemsPanel>
                  <GridView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Border Width="40"
                              Height="40">
                        <TextBlock Text="{x:Bind}"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Padding="0,0,0,6"
                                   FontWeight="Light"
                                   FontSize="20" />
                      </Border>
                    </DataTemplate>
                  </GridView.ItemTemplate>
                </GridView>
              </StackPanel>
            </Flyout>
          </tmpls:SubtleIconToggleSplitButton.Flyout>
        </tmpls:SubtleIconToggleSplitButton>

        <Rectangle Width="1"
                   Stretch="Fill"
                   Margin="0,6"
                   Fill="{ThemeResource DividerStrokeColorDefault}" />

        <!-- Font Size -->
        <tmpls:SubtleIconButton x:Name="NotePage_FontSizeButton"
                                x:Uid="/NotePage/FontSizeButton"
                                Content="{ctw:FontIcon Glyph=&#xE8E9;}">
          <tmpls:SubtleIconButton.Flyout>
            <Flyout Placement="Top"
                    ShouldConstrainToRootBounds="False">
              <StackPanel Spacing="12">
                <TextBlock x:Uid="/NotePage/FontSizeFlyoutHeaderTextBlock"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />

                <StackPanel Orientation="Horizontal"
                            Spacing="6">
                  <RepeatButton x:Name="NotePage_DecreaseFontSizeButton"
                                x:Uid="/NotePage/DecreaseFontSizeButton"
                                Content="{ctw:FontIcon Glyph=&#xE949;}"
                                Style="{StaticResource SubtleIconRepeatButtonStyle}"
                                Command="{x:Bind EditorViewModel.DecreaseSelectionFontSizeCommand}" />
                  <ComboBox x:Name="NotePage_FontSizeComboBox"
                            Width="90"
                            VerticalAlignment="Center"
                            IsEditable="True"
                            IsTextSearchEnabled="False"
                            ItemsSource="{x:Bind EditorViewModel.FontSizes}"
                            SelectedItem="{x:Bind EditorViewModel.SelectionFontSizeText, Mode=TwoWay}"
                            Text="{x:Bind EditorViewModel.SelectionFontSizeText, Mode=OneWay}" />
                  <RepeatButton x:Name="NotePage_IncreaseFontSizeButton"
                                x:Uid="/NotePage/IncreaseFontSizeButton"
                                Content="{ctw:FontIcon Glyph=&#xE948;}"
                                Style="{StaticResource SubtleIconRepeatButtonStyle}"
                                Command="{x:Bind EditorViewModel.IncreaseSelectionFontSizeCommand}" />
                </StackPanel>
              </StackPanel>
            </Flyout>
          </tmpls:SubtleIconButton.Flyout>
        </tmpls:SubtleIconButton>

        <!-- Font Color -->
        <tmpls:SubtleIconSplitButton x:Name="NotePage_FontColorButton"
                                     x:Uid="/NotePage/FontColorButton">
          <tmpls:SubtleIconSplitButton.Content>
            <Grid>
              <Border CornerRadius="3"
                      RenderTransformOrigin="0.5, 0.95">
                <Border.RenderTransform>
                  <ScaleTransform ScaleX="0.8"
                                  ScaleY="0.3" />
                </Border.RenderTransform>
                <Border Background="{x:Bind helpers:ColorHelper.ToBrush(EditorViewModel.RecentFontColor), Mode=OneWay}" />
              </Border>
              <FontIcon Glyph="&#xE8D3;" />

            </Grid>
          </tmpls:SubtleIconSplitButton.Content>

          <mxi:Interaction.Behaviors>
            <mxi:EventTriggerBehavior EventName="Click">
              <mxi:InvokeCommandAction Command="{x:Bind EditorViewModel.ChangeSelectionFontColorCommand}" />
            </mxi:EventTriggerBehavior>
          </mxi:Interaction.Behaviors>

          <tmpls:SubtleIconSplitButton.SecondaryFlyout>
            <Flyout Placement="Top"
                    ShouldConstrainToRootBounds="False">
              <StackPanel Spacing="12"
                          Width="340">
                <TextBlock x:Uid="/NotePage/FontColorFlyoutHeaderTextBlock"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ctwc:Segmented x:Name="NotePage_FontColorSegmented"
                                HorizontalAlignment="Center"
                                SelectedIndex="0">
                  <ctwc:SegmentedItem x:Uid="/NotePage/ColorPaletteSegmentedItem"
                                      Icon="{ctw:FontIcon Glyph=&#xE790;}"
                                      Width="160" />
                  <ctwc:SegmentedItem x:Uid="/NotePage/ColorPickerSegmentedItem"
                                      Icon="{ctw:FontIcon Glyph=&#xEF3C;}"
                                      Width="160" />
                </ctwc:Segmented>
                <ctwc:SwitchPresenter Value="{x:Bind NotePage_FontColorSegmented.SelectedIndex, Mode=OneWay}">
                  <ctwc:Case>
                    <ctwc:Case.Value>
                      <x:Int32>0</x:Int32>
                    </ctwc:Case.Value>
                    <Grid MaxHeight="363"
                          HorizontalAlignment="Center">
                      <GridView x:Name="NotePage_FontColorPaletteGridView"
                                ItemsSource="{x:Bind EditorViewModel.PaletteFontColors}"
                                SelectedItem="{x:Bind EditorViewModel.SelectedPaletteFontColor, Mode=TwoWay}"
                                Padding="12,0">
                        <GridView.ItemsPanel>
                          <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"
                                           MaximumRowsOrColumns="6" />
                          </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                          <DataTemplate x:DataType="SolidColorBrush">
                            <Border Width="48"
                                    Height="48"
                                    Background="{x:Bind}"
                                    CornerRadius="4"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefault}" />
                          </DataTemplate>
                        </GridView.ItemTemplate>
                      </GridView>
                    </Grid>
                  </ctwc:Case>
                  <ctwc:Case>
                    <ctwc:Case.Value>
                      <x:Int32>1</x:Int32>
                    </ctwc:Case.Value>
                    <ColorPicker x:Name="NotePage_FontColorPicker"
                                 Color="{x:Bind EditorViewModel.SelectionFontColor, Mode=TwoWay}"
                                 ColorSpectrumShape="Ring"
                                 IsAlphaEnabled="False"
                                 IsMoreButtonVisible="True" />
                  </ctwc:Case>
                </ctwc:SwitchPresenter>
              </StackPanel>
            </Flyout>
          </tmpls:SubtleIconSplitButton.SecondaryFlyout>
        </tmpls:SubtleIconSplitButton>

        <!-- Text Highlight Color -->
        <tmpls:SubtleIconSplitButton x:Name="NotePage_TextHighlightColorButton"
                                     x:Uid="/NotePage/TextHighlightColorButton">
          <tmpls:SubtleIconSplitButton.Content>
            <Grid>
              <FontIcon Glyph="&#xE891;"
                        Foreground="{x:Bind helpers:ColorHelper.ToBrush(EditorViewModel.RecentHighlightColor), Mode=OneWay}" />
              <FontIcon Glyph="&#xE7E6;" />

            </Grid>
          </tmpls:SubtleIconSplitButton.Content>

          <mxi:Interaction.Behaviors>
            <mxi:EventTriggerBehavior EventName="Click">
              <mxi:InvokeCommandAction Command="{x:Bind EditorViewModel.ChangeSelectionHighlightColorCommand}" />
            </mxi:EventTriggerBehavior>
          </mxi:Interaction.Behaviors>

          <tmpls:SubtleIconSplitButton.SecondaryFlyout>
            <Flyout Placement="Top"
                    ShouldConstrainToRootBounds="False">
              <StackPanel Spacing="12"
                          Width="340">
                <TextBlock x:Uid="/NotePage/TextHighlightColorFlyoutHeaderTextBlock"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />

                <Button x:Uid="/NotePage/TextHighlightColorAutomaticButton"
                        HorizontalAlignment="Stretch"
                        Margin="8,0"
                        Command="{x:Bind EditorViewModel.ChangeSelectionHighlightColorToAutomaticCommand}">
                  <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled"
                                     Color="{ThemeResource ControlAltFillColorQuarternary}" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled"
                                     Color="{ThemeResource TextFillColorPrimary}" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled"
                                     Color="{ThemeResource ControlStrokeColorOnAccentTertiary}" />
                  </Button.Resources>
                </Button>
                <ctwc:Segmented x:Name="NotePage_TextHighlightColorSegmented"
                                HorizontalAlignment="Center"
                                SelectedIndex="0">
                  <ctwc:SegmentedItem x:Uid="/NotePage/ColorPaletteSegmentedItem"
                                      Icon="{ctw:FontIcon Glyph=&#xE790;}"
                                      Width="160" />
                  <ctwc:SegmentedItem x:Uid="/NotePage/ColorPickerSegmentedItem"
                                      Icon="{ctw:FontIcon Glyph=&#xEF3C;}"
                                      Width="160" />
                </ctwc:Segmented>
                <ctwc:SwitchPresenter Value="{x:Bind NotePage_TextHighlightColorSegmented.SelectedIndex, Mode=OneWay}">
                  <ctwc:Case>
                    <ctwc:Case.Value>
                      <x:Int32>0</x:Int32>
                    </ctwc:Case.Value>
                    <Grid MaxHeight="363"
                          HorizontalAlignment="Center">
                      <GridView x:Name="NotePage_TextHighlightColorPaletteGridView"
                                ItemsSource="{x:Bind EditorViewModel.PaletteHighlightColors}"
                                SelectedItem="{x:Bind EditorViewModel.SelectedPaletteHighlightColor, Mode=TwoWay}"
                                Padding="12,0">
                        <GridView.ItemsPanel>
                          <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"
                                           MaximumRowsOrColumns="6" />
                          </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                          <DataTemplate x:DataType="SolidColorBrush">
                            <Border Width="48"
                                    Height="48"
                                    Background="{x:Bind}"
                                    CornerRadius="4"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefault}" />
                          </DataTemplate>
                        </GridView.ItemTemplate>
                      </GridView>
                    </Grid>
                  </ctwc:Case>
                  <ctwc:Case>
                    <ctwc:Case.Value>
                      <x:Int32>1</x:Int32>
                    </ctwc:Case.Value>
                    <ColorPicker x:Name="NotePage_TextHighlightColorPicker"
                                 Color="{x:Bind EditorViewModel.SelectionHighlightColor, Mode=TwoWay}"
                                 ColorSpectrumShape="Ring"
                                 MaxValue="99"
                                 IsAlphaEnabled="False"
                                 IsMoreButtonVisible="True" />
                  </ctwc:Case>
                </ctwc:SwitchPresenter>
              </StackPanel>
            </Flyout>
          </tmpls:SubtleIconSplitButton.SecondaryFlyout>
          <tmpls:SubtleIconSplitButton.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control,Shift"
                                 Key="H" />
          </tmpls:SubtleIconSplitButton.KeyboardAccelerators>
        </tmpls:SubtleIconSplitButton>

        <Rectangle Width="1"
                   Stretch="Fill"
                   Margin="0,6"
                   Fill="{ThemeResource DividerStrokeColorDefault}" />

        <!-- Background and Backdrop -->
        <tmpls:SubtleIconButton x:Name="NotePage_BackgroundButton"
                                x:Uid="/NotePage/BackgroundButton"
                                Content="{ctw:FontIcon Glyph=&#xE790;}">
          <tmpls:SubtleIconButton.Flyout>
            <Flyout x:Name="NotePage_BackgroundFlyout"
                    Placement="Top"
                    ShouldConstrainToRootBounds="False"
                    FlyoutPresenterStyle="{StaticResource DefaultThemeFlyoutPresenterStyle}">

              <StackPanel Width="340"
                          MinHeight="300">
                <TextBlock x:Uid="/NotePage/BackgroundFlyoutHeaderTextBlock"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           Margin="0,0,0,12" />
                <ctwc:Segmented x:Name="NotePage_BackgroundSegmented"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="0">
                  <ctwc:SegmentedItem Icon="{ctw:FontIcon Glyph=&#xE790;}"
                                      Content="Color"
                                      HorizontalAlignment="Stretch" />
                  <ctwc:SegmentedItem Icon="{ctw:FontIcon Glyph=&#xE794;}"
                                      Content="Effect"
                                      HorizontalAlignment="Stretch" />
                  <ctwc:SegmentedItem Icon="{ctw:FontIcon Glyph=&#xE91B;}"
                                      Content="Image"
                                      HorizontalAlignment="Stretch" />
                </ctwc:Segmented>
                <ctwc:SwitchPresenter Value="{x:Bind NotePage_BackgroundSegmented.SelectedIndex, Mode=OneWay}">
                  <!-- Background Color -->
                  <ctwc:Case>
                    <ctwc:Case.Value>
                      <x:Int32>0</x:Int32>
                    </ctwc:Case.Value>
                    <StackPanel Spacing="12">
                      <SelectorBar x:Name="NotePage_BackgroundColorSelectorBar"
                                   HorizontalAlignment="Center"
                                   SelectedItem="{x:Bind NotePage_ColorPaletteSelectorBarItem}">
                        <SelectorBarItem x:Name="NotePage_ColorPaletteSelectorBarItem"
                                         Icon="{ctw:FontIcon Glyph=&#xE790;}"
                                         Text="Palette" />
                        <SelectorBarItem x:Name="NotePage_ColorPickerSelectorBarItem"
                                         Icon="{ctw:FontIcon Glyph=&#xEF3C;}"
                                         Text="Picker" />
                      </SelectorBar>

                      <ctwc:SwitchPresenter Value="{x:Bind NotePage_BackgroundColorSelectorBar.SelectedItem, Mode=OneWay}">
                        <ctwc:Case Value="{x:Bind NotePage_ColorPaletteSelectorBarItem}">
                          <Grid MaxHeight="411"
                                HorizontalAlignment="Center">
                            <GridView x:Name="NotePage_BackgroundColorPaletteGridView"
                                      ItemsSource="{x:Bind ViewModel.PaletteBackgroundColors}"
                                      SelectedItem="{x:Bind ViewModel.SelectedPaletteBackgroundColor, Mode=TwoWay}"
                                      Padding="12,0">
                              <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <ItemsWrapGrid Orientation="Horizontal"
                                                 MaximumRowsOrColumns="6" />
                                </ItemsPanelTemplate>
                              </GridView.ItemsPanel>
                              <GridView.ItemTemplate>
                                <DataTemplate x:DataType="SolidColorBrush">
                                  <Border Width="48"
                                          Height="48"
                                          Background="{x:Bind}"
                                          CornerRadius="4"
                                          BorderThickness="1"
                                          BorderBrush="{ThemeResource CardStrokeColorDefault}" />
                                </DataTemplate>
                              </GridView.ItemTemplate>
                            </GridView>
                          </Grid>
                        </ctwc:Case>
                        <ctwc:Case Value="{x:Bind NotePage_ColorPickerSelectorBarItem}">
                          <ColorPicker x:Name="NotePage_BackgroundColorPicker"
                                       IsAlphaEnabled="False"
                                       ColorSpectrumShape="Ring"
                                       IsMoreButtonVisible="True"
                                       Color="{x:Bind ViewModel.Note.BackgroundColor, Mode=TwoWay}" />
                        </ctwc:Case>

                      </ctwc:SwitchPresenter>
                    </StackPanel>
                  </ctwc:Case>

                  <!-- Backdrop(Background Effect) -->
                  <ctwc:Case>
                    <ctwc:Case.Value>
                      <x:Int32>1</x:Int32>
                    </ctwc:Case.Value>

                    <StackPanel Spacing="12"
                                Padding="0,12">
                      <RadioButtons x:Name="NotePage_BackdropRadioButtons"
                                    x:Uid="/NotePage/BackdropRadioButtons"
                                    Header="Backdrop kind"
                                    SelectedIndex="{x:Bind ViewModel.Note.BackdropKind, Mode=TwoWay, Converter={StaticResource BackdropKindToIntConverter}}"
                                    MaxColumns="3">
                        <RadioButton x:Uid="/NotePage/BackdropNoneRadioButton"
                                     MinWidth="100" />
                        <RadioButton x:Uid="/NotePage/BackdropAcrylicRadioButton"
                                     MinWidth="100" />
                        <RadioButton x:Uid="/NotePage/BackdropMicaRadioButton"
                                     MinWidth="100" />
                      </RadioButtons>

                      <NavigationViewItemSeparator />

                      <Grid RowSpacing="4"
                            ColumnSpacing="8">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="3"
                                   Text="Tint opacity" />

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   Width="32"
                                   Text="{x:Bind helpers:NumericHelper.Round(ViewModel.Note.BackdropTintOpacity, 2), Mode=OneWay}" />
                        <Slider Grid.Row="1"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Minimum="0"
                                Maximum="1"
                                StepFrequency="0.01"
                                IsThumbToolTipEnabled="False"
                                Value="{x:Bind ViewModel.Note.BackdropTintOpacity, Mode=TwoWay}"
                                IsEnabled="{x:Bind IsBackdropPropertySliderEnabled(ViewModel.Note.BackdropKind), Mode=OneWay}" />
                        <tmpls:SubtleIconButton Grid.Row="1"
                                                Grid.Column="2"
                                                Content="{ctw:FontIcon Glyph=&#xE72C;}"
                                                Style="{StaticResource SubtleIconButtonStyle_32x16}"
                                                IsEnabled="{x:Bind IsBackdropPropertySliderEnabled(ViewModel.Note.BackdropKind), Mode=OneWay}" />
                      </Grid>

                      <Grid RowSpacing="4"
                            ColumnSpacing="8">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="3"
                                   Text="Luminosity opacity" />

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   Width="32"
                                   Text="{x:Bind helpers:NumericHelper.Round(ViewModel.Note.BackdropLuminosityOpacity, 2), Mode=OneWay}" />
                        <Slider Grid.Row="1"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Minimum="0"
                                Maximum="1"
                                StepFrequency="0.01"
                                IsThumbToolTipEnabled="False"
                                Value="{x:Bind ViewModel.Note.BackdropLuminosityOpacity, Mode=TwoWay}"
                                IsEnabled="{x:Bind IsBackdropPropertySliderEnabled(ViewModel.Note.BackdropKind), Mode=OneWay}" />
                        <tmpls:SubtleIconButton Grid.Row="1"
                                                Grid.Column="2"
                                                Content="{ctw:FontIcon Glyph=&#xE72C;}"
                                                Style="{StaticResource SubtleIconButtonStyle_32x16}"
                                                IsEnabled="{x:Bind IsBackdropPropertySliderEnabled(ViewModel.Note.BackdropKind), Mode=OneWay}" />
                      </Grid>
                    </StackPanel>
                  </ctwc:Case>

                  <!-- Background Image -->
                  <ctwc:Case>
                    <ctwc:Case.Value>
                      <x:Int32>2</x:Int32>
                    </ctwc:Case.Value>
                    <StackPanel Spacing="12">
                      <CheckBox Content="Show background image"
                                IsChecked="{x:Bind ViewModel.Note.IsBackgroundImageVisible, Mode=TwoWay}" />

                      <RadioButtons Header="Stretch"
                                    MaxColumns="4"
                                    IsEnabled="{x:Bind ViewModel.Note.IsBackgroundImageVisible, Mode=OneWay}">
                        <RadioButton Content="None" />
                        <RadioButton Content="Fill" />
                        <RadioButton Content="Uniform" />
                        <RadioButton Content="UniformToFill" />
                      </RadioButtons>

                      <Grid RowSpacing="4"
                            ColumnSpacing="8">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="3"
                                   Text="Opacity" />

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   Width="32"
                                   Text="{x:Bind helpers:NumericHelper.Round(ViewModel.Note.BackgroundImageOpacity, 2), Mode=OneWay}" />
                        <Slider Grid.Row="1"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Minimum="0"
                                Maximum="1"
                                StepFrequency="0.01"
                                IsThumbToolTipEnabled="False"
                                Value="{x:Bind ViewModel.Note.BackgroundImageOpacity, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.Note.IsBackgroundImageVisible, Mode=OneWay}" />
                        <tmpls:SubtleIconButton Grid.Row="1"
                                                Grid.Column="2"
                                                Content="{ctw:FontIcon Glyph=&#xE72C;}"
                                                Style="{StaticResource SubtleIconButtonStyle_32x16}"
                                                IsEnabled="{x:Bind ViewModel.Note.IsBackgroundImageVisible, Mode=OneWay}" />
                      </Grid>

                      <Grid RowSpacing="4"
                            ColumnSpacing="8">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="3"
                                   Text="Blur" />

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   Width="32"
                                   Text="{x:Bind helpers:NumericHelper.Round(ViewModel.Note.BackgroundImageBlur, 2), Mode=OneWay}" />
                        <Slider Grid.Row="1"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Minimum="0"
                                Maximum="100"
                                IsThumbToolTipEnabled="False"
                                Value="{x:Bind ViewModel.Note.BackgroundImageBlur, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.Note.IsBackgroundImageVisible, Mode=OneWay}" />
                        <tmpls:SubtleIconButton Grid.Row="1"
                                                Grid.Column="2"
                                                Content="{ctw:FontIcon Glyph=&#xE72C;}"
                                                Style="{StaticResource SubtleIconButtonStyle_32x16}"
                                                IsEnabled="{x:Bind ViewModel.Note.IsBackgroundImageVisible, Mode=OneWay}" />
                      </Grid>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind ViewModel.Note.BackgroundImagePath, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   IsTextSelectionEnabled="True"
                                   ToolTipService.ToolTip="{x:Bind ViewModel.Note.BackgroundImagePath, Mode=OneWay}" />
                        <Button Grid.Column="1"
                                Content="Browse"
                                Click="NotePage_BrowseButton_Click" />
                      </Grid>
                    </StackPanel>
                  </ctwc:Case>
                </ctwc:SwitchPresenter>
              </StackPanel>
            </Flyout>
          </tmpls:SubtleIconButton.Flyout>
        </tmpls:SubtleIconButton>

        <!-- Insert Image -->
        <tmpls:SubtleIconButton x:Name="NotePage_InsertImagesButton"
                                x:Uid="/NotePage/InsertImagesButton"
                                Content="{ctw:FontIcon Glyph=&#xE91B;}" />
      </StackPanel>
    </ScrollViewer>
    <!--#endregion -->

    <!--#region InfoBar -->
    <InfoBar x:Name="NotePage_InfoBar"
             Grid.Row="1"
             Background="{ThemeResource ControlFillColorDefault}"
             HorizontalAlignment="Center"
             VerticalAlignment="Bottom"
             Margin="12,4" />
    <!--#endregion -->

    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="FlyoutThemeStates">
        <VisualState x:Name="FlyoutThemeDefault" />
        <VisualState x:Name="FlyoutThemeLight">
          <VisualState.Setters>
            <Setter Target="NotePage_BackgroundFlyout.FlyoutPresenterStyle"
                    Value="{StaticResource LightThemeFlyoutPresenterStyle}" />
            <Setter Target="NotePage_MoreButtonMenuFlyout.MenuFlyoutPresenterStyle"
                    Value="{StaticResource LightThemeMenuFlyoutPresenterStyle}" />
            <Setter Target="NotePage_FindReplaceBox.RequestedTheme"
                    Value="Light" />
            <Setter Target="NotePage_InfoBar.RequestedTheme"
                    Value="Light" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="FlyoutThemeDark">
          <VisualState.Setters>
            <Setter Target="NotePage_BackgroundFlyout.FlyoutPresenterStyle"
                    Value="{StaticResource DarkThemeFlyoutPresenterStyle}" />
            <Setter Target="NotePage_MoreButtonMenuFlyout.MenuFlyoutPresenterStyle"
                    Value="{StaticResource DarkThemeMenuFlyoutPresenterStyle}" />
            <Setter Target="NotePage_FindReplaceBox.RequestedTheme"
                    Value="Dark" />
            <Setter Target="NotePage_InfoBar.RequestedTheme"
                    Value="Dark" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>

      <VisualStateGroup x:Name="WindowActivationStates">
        <VisualState x:Name="WindowActivated">
          <Storyboard>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NotePage_CommandBarScrollViewer"
                                           Storyboard.TargetProperty="Visibility">
              <DiscreteObjectKeyFrame KeyTime="0:0:0.1"
                                      Value="Visible" />
            </ObjectAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NotePage_CommandBarScrollViewer"
                                           Storyboard.TargetProperty="Opacity"
                                           BeginTime="0:0:0.1">
              <SplineDoubleKeyFrame KeyTime="0:0:0.15"
                                    KeySpline="0.2,0.7 0.5,1.0"
                                    Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NotePage_CommandBarScrollViewer_TranslateTransform"
                                           Storyboard.TargetProperty="Y"
                                           BeginTime="0:0:0.1">
              <SplineDoubleKeyFrame KeyTime="0:0:0.15"
                                    KeySpline="0.2,0.7 0.5,1.0"
                                    Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NotePage_PinButton"
                                           Storyboard.TargetProperty="Opacity"
                                           BeginTime="0:0:0.1">
              <SplineDoubleKeyFrame KeyTime="0:0:0.15"
                                    KeySpline="0.2,0.7 0.5,1.0"
                                    Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NotePage_PinButton_TranslateTransform"
                                           Storyboard.TargetProperty="Y"
                                           BeginTime="0:0:0.1">
              <SplineDoubleKeyFrame KeyTime="0:0:0.15"
                                    KeySpline="0.2,0.7 0.5,1.0"
                                    Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NotePage_MoreButton"
                                           Storyboard.TargetProperty="Opacity"
                                           BeginTime="0:0:0.1">
              <SplineDoubleKeyFrame KeyTime="0:0:0.15"
                                    KeySpline="0.2,0.7 0.5,1.0"
                                    Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NotePage_MoreButton_TranslateTransform"
                                           Storyboard.TargetProperty="Y"
                                           BeginTime="0:0:0.1">
              <SplineDoubleKeyFrame KeyTime="0:0:0.15"
                                    KeySpline="0.2,0.7 0.5,1.0"
                                    Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NotePage_MinimizeButton"
                                           Storyboard.TargetProperty="Opacity"
                                           BeginTime="0:0:0.1">
              <SplineDoubleKeyFrame KeyTime="0:0:0.15"
                                    KeySpline="0.2,0.7 0.5,1.0"
                                    Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NotePage_MinimizeButton_TranslateTransform"
                                           Storyboard.TargetProperty="Y"
                                           BeginTime="0:0:0.1">
              <SplineDoubleKeyFrame KeyTime="0:0:0.15"
                                    KeySpline="0.2,0.7 0.5,1.0"
                                    Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NotePage_CloseButton"
                                           Storyboard.TargetProperty="Opacity"
                                           BeginTime="0:0:0.1">
              <SplineDoubleKeyFrame KeyTime="0:0:0.15"
                                    KeySpline="0.2,0.7 0.5,1.0"
                                    Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NotePage_CloseButton_TranslateTransform"
                                           Storyboard.TargetProperty="Y"
                                           BeginTime="0:0:0.1">
              <SplineDoubleKeyFrame KeyTime="0:0:0.15"
                                    KeySpline="0.2,0.7 0.5,1.0"
                                    Value="0" />
            </DoubleAnimationUsingKeyFrames>
          </Storyboard>
        </VisualState>

        <VisualState x:Name="WindowDeactivated">
          <Storyboard>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NotePage_CommandBarScrollViewer"
                                           Storyboard.TargetProperty="Visibility">
              <DiscreteObjectKeyFrame KeyTime="0"
                                      Value="Collapsed" />
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NotePage_CommandBarScrollViewer"
                                           Storyboard.TargetProperty="Opacity">
              <DiscreteObjectKeyFrame KeyTime="0"
                                      Value="0" />
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NotePage_CommandBarScrollViewer_TranslateTransform"
                                           Storyboard.TargetProperty="Y">
              <DiscreteObjectKeyFrame KeyTime="0"
                                      Value="40" />
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NotePage_PinButton"
                                           Storyboard.TargetProperty="Opacity">
              <DiscreteObjectKeyFrame KeyTime="0"
                                      Value="0" />
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NotePage_PinButton_TranslateTransform"
                                           Storyboard.TargetProperty="Y">
              <DiscreteObjectKeyFrame KeyTime="0"
                                      Value="-40" />
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NotePage_MoreButton"
                                           Storyboard.TargetProperty="Opacity">
              <DiscreteObjectKeyFrame KeyTime="0"
                                      Value="0" />
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NotePage_MoreButton_TranslateTransform"
                                           Storyboard.TargetProperty="Y">
              <DiscreteObjectKeyFrame KeyTime="0"
                                      Value="-40" />
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NotePage_MinimizeButton"
                                           Storyboard.TargetProperty="Opacity">
              <DiscreteObjectKeyFrame KeyTime="0"
                                      Value="0" />
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NotePage_MinimizeButton_TranslateTransform"
                                           Storyboard.TargetProperty="Y">
              <DiscreteObjectKeyFrame KeyTime="0"
                                      Value="-40" />
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NotePage_CloseButton"
                                           Storyboard.TargetProperty="Opacity">
              <DiscreteObjectKeyFrame KeyTime="0"
                                      Value="0" />
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NotePage_CloseButton_TranslateTransform"
                                           Storyboard.TargetProperty="Y">
              <DiscreteObjectKeyFrame KeyTime="0"
                                      Value="-40" />
            </ObjectAnimationUsingKeyFrames>
          </Storyboard>
        </VisualState>

        <VisualState x:Name="WindowDeactivatedMaximized">
          <Storyboard>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NotePage_CommandBarScrollViewer"
                                           Storyboard.TargetProperty="Visibility">
              <DiscreteObjectKeyFrame KeyTime="0"
                                      Value="Collapsed" />
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NotePage_CommandBarScrollViewer"
                                           Storyboard.TargetProperty="Opacity">
              <DiscreteObjectKeyFrame KeyTime="0"
                                      Value="0" />
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NotePage_CommandBarScrollViewer_TranslateTransform"
                                           Storyboard.TargetProperty="Y">
              <DiscreteObjectKeyFrame KeyTime="0"
                                      Value="40" />
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NotePage_PinButton"
                                           Storyboard.TargetProperty="Opacity">
              <DiscreteObjectKeyFrame KeyTime="0"
                                      Value="0" />
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NotePage_PinButton_TranslateTransform"
                                           Storyboard.TargetProperty="Y">
              <DiscreteObjectKeyFrame KeyTime="0"
                                      Value="-40" />
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NotePage_MoreButton"
                                           Storyboard.TargetProperty="Opacity">
              <DiscreteObjectKeyFrame KeyTime="0"
                                      Value="0" />
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NotePage_MoreButton_TranslateTransform"
                                           Storyboard.TargetProperty="Y">
              <DiscreteObjectKeyFrame KeyTime="0"
                                      Value="-40" />
            </ObjectAnimationUsingKeyFrames>
          </Storyboard>
        </VisualState>
      </VisualStateGroup>

      <VisualStateGroup x:Name="TitleBarTitleRenameState">
        <VisualState x:Name="TitleBarTitleNormal" />
        <VisualState x:Name="TitleBarTitleRename">
          <VisualState.Setters>
            <Setter Target="NotePage_TitleTextBlock.Visibility"
                    Value="Collapsed" />
            <Setter Target="NotePage_TitleRenameTextBox.Visibility"
                    Value="Visible" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>

      <VisualStateGroup x:Name="EditorSearchState">
        <VisualState x:Name="EditorSearchNone" />
        <VisualState x:Name="EditorSearching">
          <VisualState.Setters>
            <Setter Target="NotePage_FindReplaceBox.IsOpen"
                    Value="True" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>

      <VisualStateGroup x:Name="EditorViewModeState">
        <VisualState x:Name="ViewModeEdit" />
        <VisualState x:Name="ViewModeReadOnly">
          <VisualState.Setters>
            <Setter Target="NotePage_TextEditorRichEditBox.IsReadOnly"
                    Value="True" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
  </Grid>
</Page>
