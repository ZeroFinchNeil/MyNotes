<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="MyNotes.Views.Media.ImageViewerPage"
      x:Name="ImageViewerPage_Root"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:templates="using:MyNotes.Templates"
      xmlns:ctw="using:CommunityToolkit.WinUI"
      xmlns:helpers="using:MyNotes.Common.Helpers">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
      <templates:SubtleIconButton Content="{ctw:SymbolIcon Symbol=OpenWith}"
                                  Width="48"
                                  Height="48"
                                  Command="{x:Bind ViewModel.SelectedImage.OpenWithCommand, Mode=OneWay}" />
      <templates:SubtleIconButton Content="{ctw:SymbolIcon Symbol=OpenLocal}"
                                  Width="48"
                                  Height="48" />
      <templates:SubtleIconButton Content="{ctw:SymbolIcon Symbol=SaveLocal}"
                                  Width="48"
                                  Height="48"
                                  Command="{x:Bind ViewModel.SelectedImage.SaveImageCommand, Mode=OneWay}"
                                  CommandParameter="{x:Bind ImageViewerPage_Root.XamlRoot.ContentIslandEnvironment.AppWindowId}" />
      <templates:SubtleIconButton Content="{ctw:SymbolIcon Symbol=Delete}"
                                  Width="48"
                                  Height="48"
                                  Command="{x:Bind ViewModel.SelectedImage.DeleteImageCommand}" />
    </StackPanel>

    <FlipView Grid.Row="1"
              ItemsSource="{x:Bind ViewModel.ImageViewModels}"
              SelectedItem="{x:Bind ViewModel.SelectedImage, Mode=TwoWay}"
              Background="Transparent">
      <FlipView.ItemContainerStyle>
        <Style TargetType="FlipViewItem"
               BasedOn="{StaticResource DefaultFlipViewItemStyle}">
          <Setter Property="HorizontalAlignment"
                  Value="Center" />
          <Setter Property="VerticalAlignment"
                  Value="Center" />
          <Setter Property="VerticalContentAlignment"
                  Value="Stretch" />
          <Setter Property="HorizontalContentAlignment"
                  Value="Stretch" />
        </Style>
      </FlipView.ItemContainerStyle>
      <FlipView.ItemTemplate>
        <DataTemplate x:DataType="mvmm:ImageViewModel"
                      xmlns:mvm="using:MyNotes.Views.Media"
                      xmlns:mvmm="using:MyNotes.ViewModels.Media">
          <mvm:ImageViewItemContainer ViewModel="{x:Bind}"
                                      IsOpenInNewWindowAvailable="False"/>
        </DataTemplate>
      </FlipView.ItemTemplate>
    </FlipView>

    <TextBlock Grid.Row="1"
               Text="No image"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Visibility="{x:Bind helpers:BooleanHelper.ToInverseVisibility(ViewModel.HasImages), Mode=OneWay}"
               Style="{StaticResource HeaderTextBlockStyle}" />

    <GridView Grid.Row="2"
              ItemsSource="{x:Bind ViewModel.ImageViewModels}"
              SelectedItem="{x:Bind ViewModel.SelectedImage, Mode=TwoWay}"
              SelectionMode="Single"
              Height="96"
              HorizontalAlignment="Center">
      <GridView.ItemTemplate>
        <DataTemplate x:DataType="mvmm:ImageViewModel"
                      xmlns:mvm="using:MyNotes.Views.Media"
                      xmlns:mvmm="using:MyNotes.ViewModels.Media">
          <Image Source="{x:Bind Image, Mode=OneWay}" 
                 Height="80"
                 VerticalAlignment="Center"/>
        </DataTemplate>
      </GridView.ItemTemplate>
    </GridView>
  </Grid>
</Page>
