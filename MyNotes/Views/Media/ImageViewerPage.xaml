<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="MyNotes.Views.Media.ImageViewerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:tmpls="using:MyNotes.Templates"
      xmlns:ctw="using:CommunityToolkit.WinUI"
      xmlns:vmm="using:MyNotes.ViewModels.Media"
      xmlns:helpers="using:MyNotes.Common.Helpers">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
      <tmpls:SubtleIconButton Content="{ctw:FontIcon Glyph=&#xE712;}"
                              Width="48"
                              Height="48">
        <tmpls:SubtleIconButton.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedLeft">
            <MenuFlyoutItem x:Name="ImageViewerPage_OpenWithMenuFlyoutItem"
                            Icon="NewWindow"
                            Text="Open with..."
                            Click="ImageViewerPage_OpenWithMenuFlyoutItem_Click" />
            <MenuFlyoutItem x:Name="ImageViewerPage_SaveLocalMenuFlyoutItem"
                            Icon="SaveLocal"
                            Text="Save local"
                            Click="ImageViewerPage_SaveLocalMenuFlyoutItem_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="ImageViewerPage_DeleteImageMenuFlyoutItem"
                            Icon="Delete"
                            Text="Delete"
                            Command="{x:Bind ViewModel.DeleteImageCommand}"
                            CommandParameter="{x:Bind ViewModel.SelectedImage, Mode=OneWay}" />
          </MenuFlyout>
        </tmpls:SubtleIconButton.Flyout>
      </tmpls:SubtleIconButton>
    </StackPanel>

    <FlipView Grid.Row="1"
              ItemsSource="{x:Bind ViewModel.ImageViewModels}"
              SelectedItem="{x:Bind ViewModel.SelectedImage, Mode=TwoWay}"
              Background="Transparent">
      <FlipView.ItemContainerStyle>
        <Style TargetType="FlipViewItem"
               BasedOn="{StaticResource DefaultFlipViewItemStyle}">
          <Setter Property="HorizontalAlignment"
                  Value="Center" />
          <Setter Property="VerticalAlignment"
                  Value="Center" />
          <Setter Property="VerticalContentAlignment"
                  Value="Stretch" />
          <Setter Property="HorizontalContentAlignment"
                  Value="Stretch" />
        </Style>
      </FlipView.ItemContainerStyle>
      <FlipView.ItemTemplate>
        <DataTemplate x:DataType="vmm:ImageViewModel">
          <Image Source="{x:Bind Image}" />
        </DataTemplate>
      </FlipView.ItemTemplate>
    </FlipView>

    <TextBlock Grid.Row="1"
               Text="No image"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Visibility="{x:Bind helpers:BooleanHelper.ToInverseVisibility(ViewModel.HasImages), Mode=OneWay}"
               Style="{StaticResource HeaderTextBlockStyle}" />
  </Grid>
</Page>
