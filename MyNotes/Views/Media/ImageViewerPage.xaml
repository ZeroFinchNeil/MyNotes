<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="MyNotes.Views.Media.ImageViewerPage"
      x:Name="ImageViewerPage_Root"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:templates="using:MyNotes.Templates"
      xmlns:ctw="using:CommunityToolkit.WinUI"
      xmlns:helpers="using:MyNotes.Common.Helpers">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
      <templates:SubtleIconButton Content="{ctw:SymbolIcon Symbol=OpenWith}"
                                  Width="48"
                                  Height="48"
                                  Command="{x:Bind SelectedImage.OpenWithCommand, Mode=OneWay}" />
      <templates:SubtleIconButton Content="{ctw:FontIcon Glyph=&#xEC50;}"
                                  Width="48"
                                  Height="48" />
      <templates:SubtleIconButton Content="{ctw:SymbolIcon Symbol=Save}"
                                  Width="48"
                                  Height="48"
                                  Command="{x:Bind SelectedImage.SaveImageCommand, Mode=OneWay}"
                                  CommandParameter="{x:Bind ImageViewerPage_Root.XamlRoot.ContentIslandEnvironment.AppWindowId}" />
      <Rectangle Width="1"
                 Stretch="Fill"
                 Margin="0,6"
                 Fill="{ThemeResource DividerStrokeColorDefault}" />
      <templates:SubtleIconButton Content="{ctw:SymbolIcon Symbol=Delete}"
                                  Width="48"
                                  Height="48"
                                  Command="{x:Bind SelectedImage.DeleteImageCommand, Mode=OneWay}" />
      <Rectangle Width="1"
                 Stretch="Fill"
                 Margin="0,6"
                 Fill="{ThemeResource DividerStrokeColorDefault}" />
      <templates:SubtleIconToggleButton x:Name="ImageViewerPage_ShowPreviewToggleButton"
                                        Content="{ctw:FontIcon Glyph=&#xF597;}"
                                        IsChecked="False"
                                        Width="48"
                                        Height="48" />
    </StackPanel>

    <FlipView x:Name="ImageViewerPage_FlipView"
              Grid.Row="1"
              ItemsSource="{x:Bind ViewModel.ImageViewModels}"
              SelectedItem="{x:Bind SelectedImage, Mode=TwoWay}"
              Background="Transparent"
              CornerRadius="0" >
      <FlipView.ItemContainerStyle>
        <Style TargetType="FlipViewItem"
               BasedOn="{StaticResource DefaultFlipViewItemStyle}">
          <Setter Property="HorizontalAlignment"
                  Value="Center" />
          <Setter Property="VerticalAlignment"
                  Value="Center" />
          <Setter Property="VerticalContentAlignment"
                  Value="Stretch" />
          <Setter Property="HorizontalContentAlignment"
                  Value="Stretch" />
        </Style>
      </FlipView.ItemContainerStyle>
      <FlipView.ItemTemplate>
        <DataTemplate x:DataType="mvmm:ImageViewModel"
                      xmlns:mvm="using:MyNotes.Views.Media"
                      xmlns:mvmm="using:MyNotes.ViewModels.Media">
          <mvm:ImageViewItemContainer ViewModel="{x:Bind Mode=OneWay}" />
        </DataTemplate>
      </FlipView.ItemTemplate>
    </FlipView>

    <TextBlock Grid.Row="1"
               Text="No image"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Visibility="{x:Bind helpers:BooleanHelper.ToInverseVisibility(ViewModel.HasImages), Mode=OneWay}"
               Style="{StaticResource HeaderTextBlockStyle}" />

    <PipsPager Grid.Row="2"
               HorizontalAlignment="Center"
               Margin="4"
               NumberOfPages="{x:Bind ViewModel.ImageCount, Mode=OneWay}"
               SelectedPageIndex="{x:Bind ImageViewerPage_FlipView.SelectedIndex, Mode=TwoWay}"
               PreviousButtonVisibility="VisibleOnPointerOver"
               NextButtonVisibility="VisibleOnPointerOver"
               Visibility="{x:Bind helpers:BooleanHelper.ToInverseVisibility(ImageViewerPage_ShowPreviewToggleButton.IsChecked), Mode=OneWay}" />

    <GridView x:Name="ImageViewerPage_ThumbnailsGridView"
              x:Load="{x:Bind ImageViewerPage_ShowPreviewToggleButton.IsChecked.Value, Mode=OneWay}"
              Grid.Row="2"
              ItemsSource="{x:Bind ViewModel.ImageViewModels}"
              SelectedItem="{x:Bind SelectedImage, Mode=TwoWay}"
              SelectionMode="Single"
              Height="96"
              Padding="8"
              Background="{ThemeResource ControlAltFillColorQuarternary}"
              ScrollViewer.HorizontalScrollMode="Enabled"
              ScrollViewer.HorizontalScrollBarVisibility="Auto"
              ScrollViewer.VerticalScrollMode="Disabled"
              ScrollViewer.VerticalScrollBarVisibility="Disabled">
      <GridView.ItemsPanel>
        <ItemsPanelTemplate>
          <ItemsStackPanel Orientation="Horizontal"
                           HorizontalAlignment="Center" />
        </ItemsPanelTemplate>
      </GridView.ItemsPanel>
      <GridView.ItemTemplate>
        <DataTemplate x:DataType="mvmm:ImageViewModel"
                      xmlns:mvm="using:MyNotes.Views.Media"
                      xmlns:mvmm="using:MyNotes.ViewModels.Media">
          <mvm:ImageThumbnailItemContainer ViewModel="{x:Bind}"
                                           Width="96"
                                           Height="80"
                                           DecodePixelWidth="96"
                                           VerticalAlignment="Center" 
                                           IsEnabled="False" />
        </DataTemplate>
      </GridView.ItemTemplate>
    </GridView>
  </Grid>
</Page>
