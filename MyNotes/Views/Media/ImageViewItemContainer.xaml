<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="MyNotes.Views.Media.ImageViewItemContainer"
             x:Name="ImageViewItemContainer_Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MyNotes.Views.Media">

  <Image Stretch="{x:Bind Stretch, Mode=OneWay}"
         Source="{x:Bind ViewModel.Image, Mode=OneWay}">

    <Image.ContextFlyout>
      <MenuFlyout>
        <MenuFlyoutItem x:Uid="/ImageViewItemContainer/SaveLocalMenuFlyoutItem"
                        Icon="Save"
                        Command="{x:Bind ViewModel.SaveImageCommand, Mode=OneWay}"
                        CommandParameter="{x:Bind ImageViewItemContainer_Root.XamlRoot.ContentIslandEnvironment.AppWindowId}" />
        <MenuFlyoutSeparator />
        <MenuFlyoutItem x:Uid="/ImageViewItemContainer/DeleteMenuFlyoutItem"
                        Icon="Delete"
                        Command="{x:Bind ViewModel.DeleteImageCommand, Mode=OneWay}"
                        CommandParameter="{x:Bind XamlRoot}" />
      </MenuFlyout>
    </Image.ContextFlyout>
  </Image>
</UserControl>
