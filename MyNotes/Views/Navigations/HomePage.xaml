<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="MyNotes.Views.Navigations.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:MyNotes.Views.Navigations"
      xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
      xmlns:templates="using:MyNotes.Templates"
      xmlns:ctw="using:CommunityToolkit.WinUI">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="64" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Padding="24,12">

      <TextBlock Style="{StaticResource TitleTextBlockStyle}"
                 VerticalAlignment="Center"
                 Text="{x:Bind Navigation.Title, Mode=OneWay}" />
    </Border>

    <ScrollViewer x:Name="HomePage_ScrollViewer"
                  Grid.Row="1"
                  Padding="24,12,24,0">
      <ItemsView />
    </ScrollViewer>

    <Grid Grid.Row="1"
          Padding="24,12"
          RowSpacing="8"
          ColumnSpacing="4"
          VerticalAlignment="Bottom"
          MinHeight="89"
          MaxHeight="240">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0"
              Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
              CornerRadius="{ThemeResource ControlCornerRadius}">
        <TextBox PlaceholderText="Quick memo"
                 AcceptsReturn="True" />
      </Border>
      <templates:SubtleIconButton Grid.Column="1"
                                  Content="{ctw:SymbolIcon Symbol=Forward}"
                                  Background="{ThemeResource SubtleFillColorTertiaryBrush}"/>
    </Grid>
  </Grid>
</Page>
