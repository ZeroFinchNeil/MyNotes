<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="MyNotes.Views.Navigations.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:MyNotes.Views.Navigations"
      xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
      xmlns:templates="using:MyNotes.Templates">

  <StackPanel>
    <TextBlock Text="Home Page" />
    <Button Content="Note Window"
            Click="Button_Click" />
    <templates:SubtleIconButton >
      <templates:SubtleIconButton.Icon>
        <ImageIcon Source="{x:Bind HomePage_HeaderIconPicker.IconImage, Mode=OneWay}"/>
      </templates:SubtleIconButton.Icon>
      <templates:SubtleIconButton.Flyout>
        <Flyout Placement="BottomEdgeAlignedLeft">
          <templates:IconPicker x:Name="HomePage_HeaderIconPicker" 
                                DecodePixelWidth="40"
                                DecodePixelHeight="40"/>
        </Flyout>
      </templates:SubtleIconButton.Flyout>
    </templates:SubtleIconButton>
  </StackPanel>
</Page>
