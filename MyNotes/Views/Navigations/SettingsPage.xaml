    <PathIconSource x:Key="LayoutDynamicPathIconSource"
                    Data="M17.75,3C19.5449,3,21,4.45507,21,6.25L21,17.75C21,19.5449,19.5449,21,17.75,21L6.25,21C4.45507,21,3,19.5449,3,17.75L3,6.25C3,4.45507,4.45507,3,6.25,3L17.75,3z M4.5,15.5L4.5,17.75C4.5,18.7165,5.2835,19.5,6.25,19.5L8.5,19.5 8.5,15.5 4.5,15.5z M10,15.5L10,19.5 17.75,19.5C18.7165,19.5,19.5,18.7165,19.5,17.75L19.5,15.5 10,15.5z M6.25,4.5C5.2835,4.5,4.5,5.2835,4.5,6.25L4.5,14 8.5,14 8.5,4.5 6.25,4.5z M10,14L19.5,14 19.5,6.25C19.5,5.2835,18.7165,4.5,17.75,4.5L10,4.5 10,14z" />
