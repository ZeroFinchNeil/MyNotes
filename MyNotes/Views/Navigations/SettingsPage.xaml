                    Data="M16,19.5C16,21.43 17.57,23 19.5,23 21.43,23 23,21.43 23,19.5 23,17.57 21.43,16 19.5,16 17.57,16 16,17.57 16,19.5 M8,21L14.21,21Q14,20.25,14,19.5L14,19 8,19C6.34,19,5,17.66,5,16L5,8C5,6.34,6.34,5,8,5L16,5C17.66,5,19,6.34,19,8L19,14 19.5,14Q20.25,14,21,14.21L21,8C21,5.24,18.76,3,16,3L8,3C5.24,3,3,5.24,3,8L3,16C3,18.76,5.24,21,8,21" />
  </Page.Resources>
  <!--#endregion -->

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="64" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Padding="24,12">
      <TextBlock x:Name="SettingsPage_TitleTextBlock"
                 x:Uid="/SettingsPage/TitleTextBlock"
                 VerticalAlignment="Center"
                 Style="{StaticResource TitleTextBlockStyle}" />
    </Border>

    <ScrollViewer x:Name="SettingsPage_ScrollViewer"
                  Grid.Row="1"
                  Padding="24,12,24,0">
      <StackPanel Margin="0,0,0,24"
                  Spacing="12">
        <!--#region Appearance -->
        <StackPanel Spacing="4">
          <TextBlock x:Uid="/SettingsPage/Appearance_SubTitleTextBlock"
                     Padding="4"
                     Style="{StaticResource BaseTextBlockStyle}" />

          <!-- App Theme -->
          <controls:SettingsCard x:Uid="/SettingsPage/Appearance_ThemeSettingsCard">
            <controls:SettingsCard.HeaderIcon>
              <IconSourceElement IconSource="{StaticResource PaintBrushPathIconSource}" />
            </controls:SettingsCard.HeaderIcon>
            <ComboBox SelectedIndex="{x:Bind ViewModel.AppTheme, Mode=TwoWay, Converter={StaticResource ElementThemeToIntConverter}}"
                      MinWidth="160">
              <ComboBoxItem x:Uid="/SettingsPage/Appearance_DefaultThemeComboBoxItem"
                            Tag="Default" />
              <ComboBoxItem x:Uid="/SettingsPage/Appearance_LightThemeComboBoxItem"
                            Tag="Light" />
              <ComboBoxItem x:Uid="/SettingsPage/Appearance_DarkThemeComboBoxItem"
                            Tag="Dark" />
            </ComboBox>
          </controls:SettingsCard>

          <!-- Language -->
          <StackPanel>
            <controls:SettingsCard x:Name="SettingsPage_Appearance_LanguageSettingsCard"
                                   x:Uid="/SettingsPage/Appearance_LanguageSettingsCard"
                                   HeaderIcon="{ui:FontIcon Glyph=&#xF2B7;}">
              <ComboBox ItemsSource="{x:Bind ViewModel.AppLanguages}"
                        SelectedItem="{x:Bind ViewModel.AppLanguage, Mode=TwoWay}"
                        MinWidth="160">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="mmu:AppLanguage"
                                xmlns:mmu="using:MyNotes.Models.UI">
                    <StackPanel Orientation="Horizontal"
                                Spacing="6">
                      <TextBlock Text="{x:Bind NativeName}" />
                      <TextBlock Text="{x:Bind FormatLanguageString(DisplayName, NativeName)}"
                                 Style="{StaticResource CaptionTextBlockStyle}"
                                 VerticalAlignment="Center"
                                 Foreground="{ThemeResource TextFillColorSecondary}" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </controls:SettingsCard>
            <InfoBar x:Name="SettingsPage_Appearance_LanguageInfoBar"
                     x:Uid="/SettingsPage/Appearance_LanguageInfoBar"
                     IsOpen="True"
                     Severity="Warning"
                     IsClosable="False"
                     Visibility="Collapsed"
                     CornerRadius="0,0,4,4"
                     BorderThickness="1,0,1,1"
                     Canvas.ZIndex="-1">
              <InfoBar.ActionButton>
                <Button x:Name="SettingsPage_Appearance_RestartButton"
                        x:Uid="/SettingsPage/Appearance_RestartButton"
                        HorizontalAlignment="Right"
                        Click="SettingsPage_Appearance_RestartButton_Click" />
              </InfoBar.ActionButton>

              <InfoBar.RenderTransform>
                <TranslateTransform x:Name="SettingsPage_Appearance_LanguageInfoBar_TranslateTransform" />
              </InfoBar.RenderTransform>

              <interactivity:Interaction.Behaviors>
                <interactivity:DataTriggerBehavior Binding="{x:Bind ViewModel.IsAppLanguageChanged, Mode=OneWay}"
                                                   Value="False">
                  <interactivity:GoToStateAction StateName="SettingsPage_LanguageSettingsNormalState" />
                </interactivity:DataTriggerBehavior>

                <interactivity:DataTriggerBehavior Binding="{x:Bind ViewModel.IsAppLanguageChanged, Mode=OneWay}"
                                                   Value="True">
                  <interactivity:GoToStateAction StateName="SettingsPage_LanguageSettingsWarningState" />
                </interactivity:DataTriggerBehavior>
              </interactivity:Interaction.Behaviors>
            </InfoBar>
          </StackPanel>
        </StackPanel>
        <!--#endregion-->

        <!--#region General -->
        <StackPanel Spacing="4">
          <TextBlock x:Uid="/SettingsPage/General_SubTitleTextBlock"
                     Padding="4"
                     Style="{ThemeResource BaseTextBlockStyle}" />

          <!-- Startup -->
          <StackPanel>
            <controls:SettingsCard x:Name="SettingsPage_General_StartupSettingsCard"
                                   x:Uid="/SettingsPage/General_StartupSettingsCard"
                                   HeaderIcon="{ui:FontIcon Glyph=&#xE7B5;}">
              <ToggleSwitch x:Name="SettingsPage_General_StartupToggleSwitch"
                            Toggled="SettingsPage_General_StartupToggleSwitch_Toggled" />
            </controls:SettingsCard>
            <InfoBar x:Name="SettingsPage_General_StartupInfoBar"
                     x:Uid="/SettingsPage/General_StartupInfoBar"
                     IsOpen="True"
                     Severity="Warning"
                     IsClosable="False"
                     Visibility="Collapsed"
                     CornerRadius="0,0,4,4"
                     BorderThickness="1,0,1,1"
                     Canvas.ZIndex="-1">
              <InfoBar.ActionButton>
                <Button x:Name="SettingsPage_General_AppStartupButton"
                        x:Uid="/SettingsPage/General_AppStartupButton"
                        HorizontalAlignment="Right"
                        Click="SettingsPage_General_AppStartupButton_Click" />
              </InfoBar.ActionButton>

              <InfoBar.RenderTransform>
                <TranslateTransform x:Name="SettingsPage_General_StartupInfoBar_TranslateTransform" />
              </InfoBar.RenderTransform>
            </InfoBar>
          </StackPanel>

          <!-- Initial Page -->
          <controls:SettingsExpander x:Uid="/SettingsPage/General_InitialPageSettingsExpander"
                                     Header="Initial page"
                                     Description="Initial page"
                                     HeaderIcon="{ui:FontIcon Glyph=&#xE72A;}"
                                     IsExpanded="{x:Bind helpers:ObjectHelper.IsEqual(ViewModel.InitialPageType, nav:InitialPageType.Preferred), Mode=OneWay}"
                                     xmlns:nav="using:MyNotes.Models.Navigations.Preferences">
            <ComboBox SelectedIndex="{x:Bind ViewModel.InitialPageType, Mode=TwoWay, Converter={StaticResource InitialPageTypeToIntConverter}}"
                      MinWidth="160">
              <ComboBoxItem x:Uid="/SettingsPage/General_HomePageComboBoxItem"
                            Content="Home page" />
              <ComboBoxItem x:Uid="/SettingsPage/General_BookmarksPageComboBoxItem"
                            Content="Bookmarks page" />
              <ComboBoxItem x:Uid="/SettingsPage/General_LastOpenedPageComboBoxItem"
                            Content="Last opened page" />
              <ComboBoxItem x:Uid="/SettingsPage/General_PreferredPageComboBoxItem"
                            Content="Preferred page" />
            </ComboBox>

            <controls:SettingsExpander.Items>
              <controls:SettingsCard>
                <controls:SettingsCard.Header>
                  <StackPanel Orientation="Horizontal"
                              Spacing="8">
                    <TextBlock Text="Composite 1"
                               Style="{StaticResource BodyLargeTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondary}" />
                    <TextBlock Text=">"
                               Style="{StaticResource BodyLargeTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondary}" />
                    <TextBlock Text="{x:Bind ViewModel.InitialPageId, Mode=OneWay}"
                               Style="{StaticResource BodyLargeTextBlockStyle}" />
                  </StackPanel>
                </controls:SettingsCard.Header>
              </controls:SettingsCard>
              <controls:SettingsCard Header="Select a preferred page."
                                     HeaderIcon="Add"
                                     IsEnabled="{x:Bind helpers:ObjectHelper.IsEqual(ViewModel.InitialPageType, nav:InitialPageType.Preferred), Mode=OneWay}">
                <ComboBox ItemsSource="{x:Bind ViewModel.InitialPageOptions}"
                          SelectedItem="{x:Bind ViewModel.SelectedInitialPageOption, Mode=TwoWay}"
                          MinWidth="160">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="navigations:UserListNavigationViewModel">
                      <Grid ColumnSpacing="10"
                            VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="16" />
                          <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Viewbox Grid.Column="0"
                                 Width="16"
                                 Height="16">
                          <ImageIcon Source="{x:Bind IconImage, Mode=OneWay}" />
                        </Viewbox>
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind Navigation.Title, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"/>
                      </Grid>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </controls:SettingsCard>
            </controls:SettingsExpander.Items>
          </controls:SettingsExpander>

          <!-- Delete Confirmation -->
          <controls:SettingsCard x:Uid="/SettingsPage/General_DeleteConfirmationSettingsCard"
                                 HeaderIcon="{ui:FontIcon Glyph=&#xE8FB;}">
            <ToggleSwitch IsOn="{x:Bind ViewModel.ConfirmBeforeDeleting, Mode=TwoWay}" />
          </controls:SettingsCard>
        </StackPanel>
        <!--#endregion-->

        <!--#region Note -->
        <StackPanel Spacing="4">
          <TextBlock x:Uid="/SettingsPage/Note_SubTitleTextBlock"
                     Padding="4"
                     Style="{ThemeResource BaseTextBlockStyle}" />
          <!-- Default Note Background -->
          <controls:SettingsCard x:Uid="/SettingsPage/Note_BackgroundSettingsCard"
                                 HeaderIcon="{ui:FontIcon Glyph=&#xE790;}">
            <SplitButton>
              <Border Width="24"
                      Height="24"
                      CornerRadius="{ThemeResource ControlCornerRadius}"
                      Background="{x:Bind helpers:ColorHelper.ToBrush(ViewModel.NoteBackground), Mode=OneWay}" />
              <SplitButton.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight"
                        ShouldConstrainToRootBounds="False">
                  <StackPanel>
                    <ColorPicker IsAlphaEnabled="True"
                                 IsMoreButtonVisible="True"
                                 Color="{x:Bind ViewModel.NoteBackground, Mode=TwoWay}" />
                  </StackPanel>
                </Flyout>
              </SplitButton.Flyout>
            </SplitButton>
          </controls:SettingsCard>

          <!-- Default Note Backdrop -->
          <controls:SettingsCard x:Uid="/SettingsPage/Note_BackdropSettingsCard"
                                 HeaderIcon="{ui:FontIcon Glyph=&#xF4A5;}">
            <ComboBox SelectedIndex="{x:Bind ViewModel.NoteBackdrop, Mode=TwoWay, Converter={StaticResource BackdropKindToIntConverter}}"
                      MinWidth="160">
              <ComboBoxItem x:Uid="/SettingsPage/Note_BackdropNoneComboBoxItem" />
              <ComboBoxItem x:Uid="/SettingsPage/Note_BackdropAcrylicComboBoxItem" />
              <ComboBoxItem x:Uid="/SettingsPage/Note_BackdropMicaComboBoxItem" />
            </ComboBox>
          </controls:SettingsCard>

          <!-- Default Note Size -->
          <controls:SettingsExpander x:Uid="/SettingsPage/Note_SizeSettingsExpander"
                                     HeaderIcon="{ui:FontIcon Glyph=&#xE9A6;}">
            <TextBlock Text="{x:Bind helpers:StringHelper.SizeToString(ViewModel.NoteWidth, ViewModel.NoteHeight), Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondary}" />
            <controls:SettingsExpander.Items>
              <controls:SettingsCard x:Uid="/SettingsPage/Note_WidthSettingsCard">
                <NumberBox SpinButtonPlacementMode="Inline"
                           Value="{x:Bind ViewModel.NoteWidth, Mode=TwoWay}"
                           Minimum="300"
                           Maximum="1000"
                           SmallChange="10"
                           Width="160" />
              </controls:SettingsCard>
              <controls:SettingsCard x:Uid="/SettingsPage/Note_HeightSettingsCard">
                <NumberBox SpinButtonPlacementMode="Inline"
                           Value="{x:Bind ViewModel.NoteHeight, Mode=TwoWay}"
                           Minimum="200"
                           Maximum="1000"
                           SmallChange="10"
                           Width="160" />
              </controls:SettingsCard>
            </controls:SettingsExpander.Items>
          </controls:SettingsExpander>

          <!-- Delete Empty Note -->
          <controls:SettingsCard x:Uid="/SettingsPage/Note_DeleteEmptyNoteSettingsCard">
            <controls:SettingsCard.HeaderIcon>
              <IconSourceElement IconSource="{StaticResource DocumentSplitHintOffPathIconSource}" />
            </controls:SettingsCard.HeaderIcon>
            <ToggleSwitch IsOn="{x:Bind ViewModel.DeleteEmptyNote, Mode=TwoWay}" />
          </controls:SettingsCard>
        </StackPanel>
        <!--#endregion-->

        <!--#region List and group -->
        <StackPanel Spacing="4">
          <TextBlock x:Uid="/SettingsPage/ListAndGroup_SubTitleTextBlock"
                     Padding="4"
                     Style="{ThemeResource BaseTextBlockStyle}" />

          <!-- Show Note Count SettingsCard -->
          <controls:SettingsCard x:Uid="/SettingsPage/ListAndGroup_ShowNoteCountSettingsCard">
            <controls:SettingsCard.HeaderIcon>
              <IconSourceElement IconSource="{StaticResource Document100PathIconSource}" />
            </controls:SettingsCard.HeaderIcon>
            <ToggleSwitch IsOn="{x:Bind ViewModel.ShowNoteCount, Mode=TwoWay}" />
          </controls:SettingsCard>

          <!-- Note Sort Order SettingsExpander -->
          <controls:SettingsExpander x:Uid="/SettingsPage/ListAndGroup_SortingOptionsSettingsExpander"
                                     HeaderIcon="{ui:FontIcon Glyph=&#xE8CB;}">
            <TextBlock Text="{x:Bind ViewModel.SortOrderContentText, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondary}" />
            <controls:SettingsExpander.Items>
              <controls:SettingsCard x:Uid="/SettingsPage/ListAndGroup_DefaultSortingOptionsSettingsCard">
                <Grid ColumnSpacing="12"
                      RowSpacing="4">
                  <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Uid="/SettingsPage/ListAndGroup_SortByTextBlock"
                             Grid.Row="0"
                             Grid.Column="0"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center" />
                  <TextBlock x:Uid="/SettingsPage/ListAndGroup_OrderByTextBlock"
                             Grid.Row="1"
                             Grid.Column="0"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center" />
                  <ComboBox Grid.Row="0"
                            Grid.Column="1"
                            SelectedIndex="{x:Bind ViewModel.NoteSortKey, Mode=TwoWay, Converter={StaticResource NoteSortKeyToIntConverter}}"
                            MinWidth="140">
                    <ComboBoxItem x:Uid="/SettingsPage/ListAndGroup_NoteSortKeyModifiedComboBoxItem" />
                    <ComboBoxItem x:Uid="/SettingsPage/ListAndGroup_NoteSortKeyCreatedComboBoxItem" />
                    <ComboBoxItem x:Uid="/SettingsPage/ListAndGroup_NoteSortKeyTitleComboBoxItem" />
                  </ComboBox>

                  <ComboBox Grid.Row="1"
                            Grid.Column="1"
                            SelectedIndex="{x:Bind ViewModel.NoteSortDirection, Mode=TwoWay, Converter={StaticResource SortDirectionToIntConverter}}"
                            MinWidth="140">
                    <ComboBoxItem x:Uid="/SettingsPage/ListAndGroup_NoteSortDirectionAscendingComboBoxItem" />
                    <ComboBoxItem x:Uid="/SettingsPage/ListAndGroup_NoteSortDirectionDescendingComboBoxItem" />
                  </ComboBox>
                </Grid>
              </controls:SettingsCard>

              <controls:SettingsCard x:Uid="/SettingsPage/ListAndGroup_EnableEachSortingOptionsSettingsCard">
                <ToggleSwitch IsOn="{x:Bind ViewModel.AllowCustomNoteSortOrder, Mode=TwoWay}" />
              </controls:SettingsCard>

              <controls:SettingsCard x:Uid="/SettingsPage/ListAndGroup_ResetSortingOptionsSettingsCard">
                <Button x:Uid="/SettingsPage/ListAndGroup_ResetButton" />
              </controls:SettingsCard>
            </controls:SettingsExpander.Items>
          </controls:SettingsExpander>

          <!-- Preview Layout SettingsExpander -->
          <controls:SettingsExpander x:Uid="/SettingsPage/ListAndGroup_PreviewLayoutSettingsExpander">
            <controls:SettingsExpander.HeaderIcon>
              <IconSourceElement IconSource="{StaticResource LayoutDynamicPathIconSource}" />
            </controls:SettingsExpander.HeaderIcon>
            <TextBlock Text="{x:Bind ViewModel.PreviewLayoutContentText, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondary}" />
            <controls:SettingsExpander.Items>
              <controls:SettingsCard x:Uid="/SettingsPage/ListAndGroup_DefaultPreviewLayoutSettingsCard">
                <Grid ColumnSpacing="12"
                      RowSpacing="4">
                  <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Uid="/SettingsPage/ListAndGroup_PreviewLayoutTypeTextBlock"
                             Grid.Row="0"
                             Grid.Column="0"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center" />
                  <TextBlock x:Uid="/SettingsPage/ListAndGroup_PreviewTileSizeTextBlock"
                             Grid.Row="1"
                             Grid.Column="0"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Text="Size" />
                  <TextBlock x:Uid="/SettingsPage/ListAndGroup_PreviewTileRatioTextBlock"
                             Grid.Row="2"
                             Grid.Column="0"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Text="Ratio" />

                  <ComboBox Grid.Row="0"
                            Grid.Column="1"
                            SelectedIndex="{x:Bind ViewModel.PreviewLayoutType, Mode=TwoWay, Converter={StaticResource PreviewLayoutTypeToIntConverter}}"
                            MinWidth="140">
                    <ComboBoxItem x:Uid="/SettingsPage/ListAndGroup_PreviewLayoutTypeGridComboBoxItem" />
                    <ComboBoxItem x:Uid="/SettingsPage/ListAndGroup_PreviewLayoutTypeListComboBoxItem" />
                  </ComboBox>

                  <ComboBox Grid.Row="1"
                            Grid.Column="1"
                            SelectedIndex="{x:Bind ViewModel.PreviewTileSize, Mode=TwoWay, Converter={StaticResource PreviewTileSizeToIntConverter}}"
                            MinWidth="140">
                    <ComboBoxItem x:Uid="/SettingsPage/ListAndGroup_PreviewTileSizeSmallestComboBoxItem" />
                    <ComboBoxItem x:Uid="/SettingsPage/ListAndGroup_PreviewTileSizeSmallerComboBoxItem" />
                    <ComboBoxItem x:Uid="/SettingsPage/ListAndGroup_PreviewTileSizeSmallComboBoxItem" />
                    <ComboBoxItem x:Uid="/SettingsPage/ListAndGroup_PreviewTileSizeMediumComboBoxItem" />
                    <ComboBoxItem x:Uid="/SettingsPage/ListAndGroup_PreviewTileSizeLargeComboBoxItem" />
                    <ComboBoxItem x:Uid="/SettingsPage/ListAndGroup_PreviewTileSizeLargerComboBoxItem" />
                    <ComboBoxItem x:Uid="/SettingsPage/ListAndGroup_PreviewTileSizeLargestComboBoxItem" />
                  </ComboBox>

                  <ComboBox Grid.Row="2"
                            Grid.Column="1"
                            SelectedIndex="{x:Bind ViewModel.PreviewTileRatio, Mode=TwoWay, Converter={StaticResource PreviewTileRatioToIntConverter}}"
                            MinWidth="140">
                    <ComboBoxItem x:Uid="/SettingsPage/ListAndGroup_PreviewTileRatioShorterComboBoxItem" />
                    <ComboBoxItem x:Uid="/SettingsPage/ListAndGroup_PreviewTileRatioShortComboBoxItem" />
                    <ComboBoxItem x:Uid="/SettingsPage/ListAndGroup_PreviewTileRatioSquareComboBoxItem" />
                    <ComboBoxItem x:Uid="/SettingsPage/ListAndGroup_PreviewTileRatioTallComboBoxItem" />
                    <ComboBoxItem x:Uid="/SettingsPage/ListAndGroup_PreviewTileRatioTallerComboBoxItem" />
                  </ComboBox>
                </Grid>
              </controls:SettingsCard>

              <controls:SettingsCard x:Uid="/SettingsPage/ListAndGroup_EnableEachPreviewLayoutSettingsCard">
                <ToggleSwitch IsOn="{x:Bind ViewModel.AllowCustomPreviewLayout, Mode=TwoWay}" />
              </controls:SettingsCard>

              <controls:SettingsCard x:Uid="/SettingsPage/ListAndGroup_ResetPreviewLayoutSettingsCard">
                <Button x:Uid="/SettingsPage/ListAndGroup_ResetButton" />
              </controls:SettingsCard>
            </controls:SettingsExpander.Items>
          </controls:SettingsExpander>

          <!-- Group Icon Badge SettingsCard -->
          <controls:SettingsCard x:Uid="/SettingsPage/ListAndGroup_GroupIconBadgeSettingsCard">
            <controls:SettingsCard.HeaderIcon>
              <IconSourceElement IconSource="{StaticResource SquareRoundedBadgePathIconSource}" />
            </controls:SettingsCard.HeaderIcon>
            <ComboBox SelectedIndex="{x:Bind ViewModel.GroupIconBadge, Mode=TwoWay, Converter={StaticResource GroupIconBadgeToIntConverter}}"
                      MinWidth="160">
              <ComboBoxItem x:Uid="/SettingsPage/ListAndGroup_GroupIconBadgeNoneComboBoxItem" />
              <ComboBoxItem x:Uid="/SettingsPage/ListAndGroup_GroupIconBadgeFolderComboBoxItem" />
            </ComboBox>
          </controls:SettingsCard>
        </StackPanel>
        <!--#endregion -->

        <!--#region Widget -->
        <StackPanel Spacing="4">
          <TextBlock x:Uid="/SettingsPage/Widget_SubTitleTextBlock"
                     Text="Widget"
                     Padding="4"
                     Style="{ThemeResource BaseTextBlockStyle}" />

          <!-- Show Note Count SettingsCard -->
          <controls:SettingsCard Header="Widget Settings">
            <Button Style="{StaticResource SubtleButtonStyle}">
              <SymbolIcon Symbol="Forward" />
            </Button>
          </controls:SettingsCard>
        </StackPanel>
        <!--#endregion -->

        <!--#region About -->
        <StackPanel Spacing="4">
          <TextBlock x:Uid="/SettingsPage/About_SubTitleTextBlock"
                     Padding="4"
                     Style="{ThemeResource BaseTextBlockStyle}" />
          <controls:SettingsExpander Header="MyNotes"
                                     Description="© 2026. All rights reserved.">
            <controls:SettingsExpander.HeaderIcon>
              <ImageIcon Source="/Assets/AppIcon.ico" />
            </controls:SettingsExpander.HeaderIcon>

            <TextBlock Text="v1.0.0" />
            <controls:SettingsExpander.Items>
              <controls:SettingsCard Header="About" />
            </controls:SettingsExpander.Items>
          </controls:SettingsExpander>
        </StackPanel>
        <!--#endregion-->

      </StackPanel>
    </ScrollViewer>

    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="SettingsPage_LanguageSettingsNormalState" />
        <VisualState x:Name="SettingsPage_LanguageSettingsWarningState">
          <VisualState.Setters>
            <Setter Target="SettingsPage_Appearance_LanguageSettingsCard.CornerRadius"
                    Value="4,4,0,0" />
            <Setter Target="SettingsPage_Appearance_LanguageInfoBar.Visibility"
                    Value="Visible" />
          </VisualState.Setters>
          <Storyboard>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SettingsPage_Appearance_LanguageInfoBar"
                                           Storyboard.TargetProperty="Opacity">
              <DiscreteDoubleKeyFrame KeyTime="0:0:0"
                                      Value="0" />
              <SplineDoubleKeyFrame KeyTime="0:0:0.167"
                                    KeySpline="0.30,0.30 0,0.95"
                                    Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SettingsPage_Appearance_LanguageInfoBar_TranslateTransform"
                                           Storyboard.TargetProperty="Y">
              <DiscreteDoubleKeyFrame KeyTime="0:0:0"
                                      Value="-32" />
              <SplineDoubleKeyFrame KeyTime="0:0:0.167"
                                    KeySpline="0.30,0.30 0,0.95"
                                    Value="0" />
            </DoubleAnimationUsingKeyFrames>
          </Storyboard>
        </VisualState>
      </VisualStateGroup>

      <VisualStateGroup>
        <VisualState x:Name="SettingsPage_StartupSettingsNormalState" />
        <VisualState x:Name="SettingsPage_StartupSettingsWarningState">
          <VisualState.Setters>
            <Setter Target="SettingsPage_General_StartupSettingsCard.CornerRadius"
                    Value="4,4,0,0" />
            <Setter Target="SettingsPage_General_StartupInfoBar.Visibility"
                    Value="Visible" />
          </VisualState.Setters>
          <Storyboard>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SettingsPage_General_StartupInfoBar"
                                           Storyboard.TargetProperty="Opacity">
              <DiscreteDoubleKeyFrame KeyTime="0:0:0"
                                      Value="0" />
              <SplineDoubleKeyFrame KeyTime="0:0:0.167"
                                    KeySpline="0.30,0.30 0,0.95"
                                    Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SettingsPage_General_StartupInfoBar_TranslateTransform"
                                           Storyboard.TargetProperty="Y">
              <DiscreteDoubleKeyFrame KeyTime="0:0:0"
                                      Value="-32" />
              <SplineDoubleKeyFrame KeyTime="0:0:0.167"
                                    KeySpline="0.30,0.30 0,0.95"
                                    Value="0" />
            </DoubleAnimationUsingKeyFrames>
          </Storyboard>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
  </Grid>
</Page>
