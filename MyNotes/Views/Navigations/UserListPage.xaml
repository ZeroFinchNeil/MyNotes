<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="MyNotes.Views.Navigations.UserListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:noteviews="using:MyNotes.Views.Notes"
      xmlns:templates="using:MyNotes.Templates"
      xmlns:helpers="using:MyNotes.Common.Helpers"
      xmlns:navmodels="using:MyNotes.Application.Contracts.Navigations.Models">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="64" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0"
          VerticalAlignment="Center"
          Padding="24,12"
          ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <templates:SubtleIconButton Grid.Column="0"
                                  x:Uid="IconPickerButton"
                                  Style="{StaticResource SubtleIconButtonStyle_40x24}">
        <templates:SubtleIconButton.Content>
          <ImageIcon Source="{x:Bind ViewModel.IconImage, Mode=OneWay}" />
        </templates:SubtleIconButton.Content>
        <templates:SubtleIconButton.Flyout>
          <Flyout Placement="Bottom"
                  ShouldConstrainToRootBounds="False">
            <templates:IconPicker x:Name="UpdateUserNodeDialog_IconPicker"
                                  Icon="{x:Bind NotePreviewListViewModel.Icon, Mode=TwoWay}"
                                  DecodePixelWidth="40"
                                  DecodePixelHeight="40" />
          </Flyout>
        </templates:SubtleIconButton.Flyout>
      </templates:SubtleIconButton>

      <TextBlock Grid.Column="1"
                 Style="{StaticResource TitleTextBlockStyle}"
                 Text="{x:Bind Navigation.Title, Mode=OneWay}" />

      <templates:SubtleIconButton Grid.Column="2"
                                  Command="{x:Bind NotePreviewListViewModel.AddNoteCommand}">
        <SymbolIcon Symbol="Add" />
      </templates:SubtleIconButton>

      <!--#region More Button -->
      <templates:SubtleIconButton Grid.Column="3">
        <SymbolIcon Symbol="More" />

        <templates:SubtleIconButton.Flyout>
          <MenuFlyout x:Name="UserListPage_MoreButtonMenuFlyout"
                      Placement="BottomEdgeAlignedRight">
            <!-- Rename Title -->
            <MenuFlyoutItem Text="Rename title"
                            Icon="Rename" />

            <MenuFlyoutSeparator />

            <!-- Sort & Ordering -->
            <MenuFlyoutSubItem Text="Ordering"
                               Icon="Sort">
              <RadioMenuFlyoutItem GroupName="NoteSortKey"
                                   Text="Modified"
                                   IsChecked="{x:Bind Navigation.NoteSortKey, Mode=TwoWay, Converter={StaticResource NoteSortKeyModifiedMatchConverter}}" />
              <RadioMenuFlyoutItem GroupName="NoteSortKey"
                                   Text="Created"
                                   IsChecked="{x:Bind Navigation.NoteSortKey, Mode=TwoWay, Converter={StaticResource NoteSortKeyCreatedMatchConverter}}" />
              <RadioMenuFlyoutItem GroupName="NoteSortKey"
                                   Text="Title"
                                   IsChecked="{x:Bind Navigation.NoteSortKey, Mode=TwoWay, Converter={StaticResource NoteSortKeyTitleMatchConverter}}" />
              <MenuFlyoutSeparator />
              <RadioMenuFlyoutItem GroupName="NoteSortDirection"
                                   Text="Ascending"
                                   IsChecked="{x:Bind Navigation.NoteSortDirection, Mode=TwoWay, Converter={StaticResource SortDirectionAscendingMatchConverter}}" />
              <RadioMenuFlyoutItem GroupName="NoteSortDirection"
                                   Text="Descending"
                                   IsChecked="{x:Bind Navigation.NoteSortDirection, Mode=TwoWay, Converter={StaticResource SortDirectionDescendingMatchConverter}}" />
            </MenuFlyoutSubItem>

            <!-- GridView Style -->
            <MenuFlyoutSubItem Text="View Style"
                               Icon="View">

              <!--Style: Grid / List View-->
              <templates:MenuFlyoutElementContainer Padding="8">
                <RadioButtons Header="Layout"
                              HeaderTemplate="{StaticResource ControlTextHeaderTemplate}"
                              MaxColumns="2"
                              SelectedIndex="{x:Bind Navigation.PreviewLayoutType, Mode=TwoWay, Converter={StaticResource PreviewLayoutTypeToIntConverter}}">
                  <RadioButton GroupName="Layout"
                               Tag="{StaticResource PreviewLayoutTypeGrid}"
                               Content="Grid" />
                  <RadioButton GroupName="Layout"
                               Tag="{StaticResource PreviewLayoutTypeList}"
                               Content="List" />
                </RadioButtons>
              </templates:MenuFlyoutElementContainer>

              <MenuFlyoutSeparator />

              <!--Style: View Size-->
              <templates:MenuFlyoutElementContainer Padding="8">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Slider Grid.Row="0"
                          Header="Size"
                          HeaderTemplate="{StaticResource ControlTextHeaderTemplate}"
                          Orientation="Horizontal"
                          TickFrequency="40"
                          TickPlacement="Outside"
                          Minimum="120"
                          Maximum="360"
                          Width="240"
                          SnapsTo="Ticks"
                          IsThumbToolTipEnabled="False"
                          Value="{x:Bind Navigation.PreviewTileSize, Mode=TwoWay, Converter={StaticResource PreviewTileSizeToSliderValueConverter}}" />
                  <Grid Grid.Row="1">
                    <TextBlock Text="Small"
                               HorizontalAlignment="Left"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="Medium"
                               HorizontalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="Large"
                               HorizontalAlignment="Right"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                  </Grid>
                </Grid>
              </templates:MenuFlyoutElementContainer>

              <!--Style: View Ratio-->
              <templates:MenuFlyoutElementContainer Padding="8"
                                                    Visibility="{x:Bind helpers:ObjectHelper.VisibleWhenEquals(Navigation.PreviewLayoutType, navmodels:PreviewLayoutType.Grid), Mode=OneWay}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Slider Grid.Row="0"
                          Header="Vertical ratio"
                          HeaderTemplate="{StaticResource ControlTextHeaderTemplate}"
                          Orientation="Horizontal"
                          TickFrequency="0.25"
                          TickPlacement="Outside"
                          Minimum="0.50"
                          Maximum="1.50"
                          Width="240"
                          SnapsTo="Ticks"
                          IsThumbToolTipEnabled="False"
                          Value="{x:Bind Navigation.PreviewTileRatio, Mode=TwoWay, Converter={StaticResource PreviewTileRatioToSliderValueConverter}}" />
                  <Grid Grid.Row="1">
                    <TextBlock Text="Short"
                               HorizontalAlignment="Left"
                               TextAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="Sqare"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="Tall"
                               HorizontalAlignment="Right"
                               TextAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                  </Grid>
                </Grid>
              </templates:MenuFlyoutElementContainer>
            </MenuFlyoutSubItem>

            <MenuFlyoutSeparator />

            <MenuFlyoutItem Text="Edit notes"
                            Icon="Edit" />

            <MenuFlyoutItem Text="Delete board"
                            Icon="Delete" />
          </MenuFlyout>

        </templates:SubtleIconButton.Flyout>
      </templates:SubtleIconButton>
      <!--#endregion-->
    </Grid>

    <noteviews:NotePreviewItemsContainer Grid.Row="1"
                                         ViewModel="{x:Bind NotePreviewListViewModel, Mode=OneWay}" 
                                         PreviewLayoutType="{x:Bind Navigation.PreviewLayoutType, Mode=OneWay}"
                                         PreviewTileSize="{x:Bind Navigation.PreviewTileSize, Mode=OneWay}"
                                         PreviewTileRatio="{x:Bind Navigation.PreviewTileRatio, Mode=OneWay}" />
  </Grid>
</Page>
