<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="MyNotes.Views.Navigations.UserListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:MyNotes.Views.Navigations"
      xmlns:notes="using:MyNotes.Models.Notes"
      xmlns:navigations="using:MyNotes.Models.Navigations"
      xmlns:notevm="using:MyNotes.ViewModels.Notes"
      xmlns:helpers="using:MyNotes.Helpers"
      xmlns:templates="using:MyNotes.Templates"
      xmlns:structures="using:MyNotes.Common.Structures">

  <Page.Resources>
    <notes:NoteSortKey x:Key="NoteSortKeyModified">Modified</notes:NoteSortKey>
    <notes:NoteSortKey x:Key="NoteSortKeyCreated">Created</notes:NoteSortKey>
    <notes:NoteSortKey x:Key="NoteSortKeyTitle">Title</notes:NoteSortKey>

    <structures:SortDirection x:Key="SortDirectionAscending">Ascending</structures:SortDirection>
    <structures:SortDirection x:Key="SortDirectionDescending">Descending</structures:SortDirection>

    <navigations:PreviewLayoutType x:Key="PreviewLayoutTypeGrid">Grid</navigations:PreviewLayoutType>
    <navigations:PreviewLayoutType x:Key="PreviewLayoutTypeList">List</navigations:PreviewLayoutType>

    <navigations:PreviewTileSize x:Key="PreviewTileSizeSmallest">Smallest</navigations:PreviewTileSize>
    <navigations:PreviewTileSize x:Key="PreviewTileSizeSmaller">Smaller</navigations:PreviewTileSize>
    <navigations:PreviewTileSize x:Key="PreviewTileSizeSmall">Small</navigations:PreviewTileSize>
    <navigations:PreviewTileSize x:Key="PreviewTileSizeMedium">Medium</navigations:PreviewTileSize>
    <navigations:PreviewTileSize x:Key="PreviewTileSizeLarge">Large</navigations:PreviewTileSize>
    <navigations:PreviewTileSize x:Key="PreviewTileSizeLarger">Larger</navigations:PreviewTileSize>
    <navigations:PreviewTileSize x:Key="PreviewTileSizeLargest">Largest</navigations:PreviewTileSize>

    <navigations:PreviewTileRatio x:Key="PreviewTileRatioShorter">Shorter</navigations:PreviewTileRatio>
    <navigations:PreviewTileRatio x:Key="PreviewTileRatioShort">Short</navigations:PreviewTileRatio>
    <navigations:PreviewTileRatio x:Key="PreviewTileRatioSquare">Square</navigations:PreviewTileRatio>
    <navigations:PreviewTileRatio x:Key="PreviewTileRatioTall">Tall</navigations:PreviewTileRatio>
    <navigations:PreviewTileRatio x:Key="PreviewTileRatioTaller">Taller</navigations:PreviewTileRatio>

    <Style x:Key="UserListPage_GridViewItemContainerStyle"
           TargetType="GridViewItem"
           BasedOn="{StaticResource DefaultGridViewItemStyle}">
      <Setter Property="HorizontalContentAlignment"
              Value="Stretch" />
      <Setter Property="VerticalContentAlignment"
              Value="Stretch" />
    </Style>

    <ItemsPanelTemplate x:Key="UserListPage_GridViewItemsPanel_LayoutGrid">
      <ItemsWrapGrid Orientation="Horizontal" />
    </ItemsPanelTemplate>

    <ItemsPanelTemplate x:Key="UserListPage_GridViewItemsPanel_LayoutList">
      <ItemsStackPanel />
    </ItemsPanelTemplate>

    <DataTemplate x:Key="UserListPage_GridViewItemTemplate_LayoutGrid"
                  x:DataType="notevm:NoteViewModel">
      <local:UserListPageNoteItemGridContainer ViewModel="{x:Bind}"
                                               Margin="6" />
    </DataTemplate>
    <DataTemplate x:Key="UserListPage_GridViewItemTemplate_LayoutList"
                  x:DataType="notevm:NoteViewModel">
      <local:UserListPageNoteItemListContainer ViewModel="{x:Bind}"
                                               Margin="6" />
    </DataTemplate>
  </Page.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="64" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0"
          VerticalAlignment="Center"
          Padding="24,12"
          ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <templates:SubtleIconButton Grid.Column="0"
                                  x:Uid="IconPickerButton"
                                  Style="{StaticResource SubtleIconButtonStyle_40x24}">
        <templates:SubtleIconButton.Content>
          <ImageIcon Source="{x:Bind ViewModel.IconImage, Mode=OneWay}" />
        </templates:SubtleIconButton.Content>
        <templates:SubtleIconButton.Flyout>
          <Flyout Placement="Bottom"
                  ShouldConstrainToRootBounds="False">
            <templates:IconPicker x:Name="UpdateUserNodeDialog_IconPicker"
                                  Icon="{x:Bind ViewModel.Navigation.Icon, Mode=TwoWay}"
                                  DecodePixelWidth="40"
                                  DecodePixelHeight="40" />
          </Flyout>
        </templates:SubtleIconButton.Flyout>
      </templates:SubtleIconButton>

      <TextBlock Grid.Column="1"
                 Style="{StaticResource TitleTextBlockStyle}"
                 Text="{x:Bind ViewModel.Navigation.Title, Mode=OneWay}" />

      <templates:SubtleIconButton Grid.Column="2"
                                  Command="{x:Bind ViewModel.AddNoteCommand}">
        <SymbolIcon Symbol="Add" />
      </templates:SubtleIconButton>

      <!--#region More Button -->
      <templates:SubtleIconButton Grid.Column="3">
        <SymbolIcon Symbol="More" />

        <templates:SubtleIconButton.Flyout>
          <MenuFlyout x:Name="UserListPage_MoreButtonMenuFlyout"
                      Placement="BottomEdgeAlignedRight"
                      Opening="UserListPage_MoreButtonMenuFlyout_Opening">
            <!-- Rename Title -->
            <MenuFlyoutItem Text="Rename title"
                            Icon="Rename" />

            <MenuFlyoutSeparator />

            <!-- Sort & Ordering -->
            <MenuFlyoutSubItem Text="Ordering"
                               Icon="Sort">
              <RadioMenuFlyoutItem GroupName="NoteSortKey"
                                   Text="Modified"
                                   Tag="{StaticResource NoteSortKeyModified}"
                                   IsChecked="{x:Bind Equals(ViewModel.NoteSortKey, notes:NoteSortKey.Modified)}"
                                   Click="UserListPage_NoteSortKeyRadioMenuFlyoutItem_Click" />
              <RadioMenuFlyoutItem GroupName="NoteSortKey"
                                   Text="Created"
                                   Tag="{StaticResource NoteSortKeyCreated}"
                                   IsChecked="{x:Bind Equals(ViewModel.NoteSortKey, notes:NoteSortKey.Created)}"
                                   Click="UserListPage_NoteSortKeyRadioMenuFlyoutItem_Click" />
              <RadioMenuFlyoutItem GroupName="NoteSortKey"
                                   Text="Title"
                                   Tag="{StaticResource NoteSortKeyTitle}"
                                   IsChecked="{x:Bind Equals(ViewModel.NoteSortKey, notes:NoteSortKey.Title)}"
                                   Click="UserListPage_NoteSortKeyRadioMenuFlyoutItem_Click" />
              <MenuFlyoutSeparator />
              <RadioMenuFlyoutItem GroupName="NoteSortDirection"
                                   Text="Ascending"
                                   Tag="{StaticResource SortDirectionAscending}"
                                   IsChecked="{x:Bind Equals(ViewModel.NoteSortDirection, structures:SortDirection.Ascending)}"
                                   Click="UserListPage_NoteSortDirectionRadioMenuFlyoutItem_Click" />
              <RadioMenuFlyoutItem GroupName="NoteSortDirection"
                                   Text="Descending"
                                   Tag="{StaticResource SortDirectionDescending}"
                                   IsChecked="{x:Bind Equals(ViewModel.NoteSortDirection, structures:SortDirection.Descending)}"
                                   Click="UserListPage_NoteSortDirectionRadioMenuFlyoutItem_Click" />
            </MenuFlyoutSubItem>

            <!-- GridView Style -->
            <MenuFlyoutSubItem Text="View Style"
                               Icon="View">

              <!--Style: Grid / List View-->
              <templates:MenuFlyoutElementContainer Padding="8">
                <RadioButtons Header="Layout"
                              HeaderTemplate="{StaticResource ControlTextHeaderTemplate}"
                              MaxColumns="2"
                              SelectedIndex="{x:Bind PreviewLayoutTypeMap.RightFromLeft(ViewModel.PreviewLayoutType), Mode=TwoWay, BindBack=SelectedIndexToPreviewLayoutType}">
                  <RadioButton GroupName="Layout"
                               Tag="{StaticResource PreviewLayoutTypeGrid}"
                               Content="Grid" />
                  <RadioButton GroupName="Layout"
                               Tag="{StaticResource PreviewLayoutTypeList}"
                               Content="List" />
                </RadioButtons>
              </templates:MenuFlyoutElementContainer>
              
              <MenuFlyoutSeparator />

              <!--Style: View Size-->
              <templates:MenuFlyoutElementContainer Padding="8">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Slider x:Name="UserListPage_ViewSizeSlider"
                          Grid.Row="0"
                          Header="Size"
                          HeaderTemplate="{StaticResource ControlTextHeaderTemplate}"
                          Orientation="Horizontal"
                          TickFrequency="40"
                          TickPlacement="Outside"
                          Minimum="120"
                          Maximum="360"
                          Width="240"
                          SnapsTo="Ticks"
                          IsThumbToolTipEnabled="False"
                          Value="{x:Bind PreviewTileSizeMap.RightFromLeft(ViewModel.PreviewTileSize), Mode=TwoWay, BindBack=SliderValueToPreviewTileSize}" />
                  <Grid Grid.Row="1">
                    <TextBlock Text="Small"
                               HorizontalAlignment="Left"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="Medium"
                               HorizontalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="Large"
                               HorizontalAlignment="Right"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                  </Grid>
                </Grid>
              </templates:MenuFlyoutElementContainer>

              <!--Style: View Ratio-->
              <templates:MenuFlyoutElementContainer Padding="8"
                                                    Visibility="{x:Bind VisibleWhenEquals(ViewModel.PreviewLayoutType, navigations:PreviewLayoutType.Grid), Mode=OneWay}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Slider x:Name="UserListPage_ViewRatioSlider"
                          Grid.Row="0"
                          Header="Vertical ratio"
                          HeaderTemplate="{StaticResource ControlTextHeaderTemplate}"
                          Orientation="Horizontal"
                          TickFrequency="0.25"
                          TickPlacement="Outside"
                          Minimum="0.50"
                          Maximum="1.50"
                          Width="240"
                          SnapsTo="Ticks"
                          IsThumbToolTipEnabled="False"
                          Value="{x:Bind PreviewTileRatioMap.RightFromLeft(ViewModel.PreviewTileRatio), Mode=TwoWay, BindBack=SliderValueToPreviewTileRatio}" />
                  <Grid Grid.Row="1">
                    <TextBlock Text="Short"
                               HorizontalAlignment="Left"
                               TextAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="Sqare"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="Tall"
                               HorizontalAlignment="Right"
                               TextAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                  </Grid>
                </Grid>
              </templates:MenuFlyoutElementContainer>
            </MenuFlyoutSubItem>

            <MenuFlyoutSeparator />

            <MenuFlyoutItem Text="Edit notes"
                            Icon="Edit" />

            <MenuFlyoutItem Text="Delete board"
                            Icon="Delete" />
          </MenuFlyout>

        </templates:SubtleIconButton.Flyout>
      </templates:SubtleIconButton>
      <!--#endregion-->
    </Grid>

    <GridView x:Name="UserListPage_NotesListGridView"
              Grid.Row="1"
              ItemsSource="{x:Bind ViewModel.NoteViewModels, Mode=OneWay}"
              SelectionMode="None"
              AllowFocusOnInteraction="False"
              ScrollViewer.VerticalScrollMode="Enabled"
              ScrollViewer.VerticalScrollBarVisibility="Visible">
      <GridView.ItemTemplate>
        <DataTemplate x:DataType="notevm:NoteViewModel">
          <local:UserListPageNoteItemGridContainer ViewModel="{x:Bind}"
                                                   Margin="6" />
        </DataTemplate>
      </GridView.ItemTemplate>
    </GridView>
  </Grid>
</Page>
