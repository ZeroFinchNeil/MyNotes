<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="MyNotes.Views.Navigations.BookmarksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:templates="using:MyNotes.Templates"
      xmlns:navEnums="using:MyNotes.Shared.Enums.Navigations">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="64" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0"
          VerticalAlignment="Center"
          Padding="24,12"
          ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0"
                 Style="{StaticResource TitleTextBlockStyle}"
                 Text="{x:Bind ViewModel.Navigation.Title, Mode=OneWay}" />

      <!--#region More Button -->
      <templates:SubtleIconButton Grid.Column="1">
        <SymbolIcon Symbol="More" />

        <templates:SubtleIconButton.Flyout>
          <MenuFlyout x:Name="BookmarksPage_MoreButtonMenuFlyout"
                      Placement="BottomEdgeAlignedRight">
            <!-- GridView Style -->
            <MenuFlyoutSubItem Text="View Style"
                               Icon="View">

              <!--Style: Grid / List View-->
              <templates:MenuFlyoutElementContainer Padding="8">
                <RadioButtons Header="Layout"
                              HeaderTemplate="{StaticResource ControlTextHeaderTemplate}"
                              MaxColumns="2"
                              SelectedIndex="{x:Bind NoteListViewModel.ToInt(NoteListViewModel.PreviewLayoutType), Mode=TwoWay, BindBack=PreviewLayoutTypeBindBack}">
                  <RadioButton GroupName="Layout"
                               Tag="{StaticResource PreviewLayoutTypeGrid}"
                               Content="Grid" />
                  <RadioButton GroupName="Layout"
                               Tag="{StaticResource PreviewLayoutTypeList}"
                               Content="List" />
                </RadioButtons>
              </templates:MenuFlyoutElementContainer>

              <MenuFlyoutSeparator />

              <!--Style: View Size-->
              <templates:MenuFlyoutElementContainer Padding="8">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Slider x:Name="BookmarksPage_ViewSizeSlider"
                          Grid.Row="0"
                          Header="Size"
                          HeaderTemplate="{StaticResource ControlTextHeaderTemplate}"
                          Orientation="Horizontal"
                          TickFrequency="40"
                          TickPlacement="Outside"
                          Minimum="120"
                          Maximum="360"
                          Width="240"
                          SnapsTo="Ticks"
                          IsThumbToolTipEnabled="False"
                          Value="{x:Bind NoteListViewModel.ToDouble(NoteListViewModel.PreviewTileSize), Mode=TwoWay, BindBack=PreviewTileSizeBindBack}" />
                  <Grid Grid.Row="1">
                    <TextBlock Text="Small"
                               HorizontalAlignment="Left"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="Medium"
                               HorizontalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="Large"
                               HorizontalAlignment="Right"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                  </Grid>
                </Grid>
              </templates:MenuFlyoutElementContainer>

              <!--Style: View Ratio-->
              <templates:MenuFlyoutElementContainer Padding="8"
                                                    Visibility="{x:Bind NoteListViewModel.VisibleWhenEquals(NoteListViewModel.PreviewLayoutType, navEnums:PreviewLayoutType.Grid), Mode=OneWay}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Slider x:Name="BookmarksPage_ViewRatioSlider"
                          Grid.Row="0"
                          Header="Vertical ratio"
                          HeaderTemplate="{StaticResource ControlTextHeaderTemplate}"
                          Orientation="Horizontal"
                          TickFrequency="0.25"
                          TickPlacement="Outside"
                          Minimum="0.50"
                          Maximum="1.50"
                          Width="240"
                          SnapsTo="Ticks"
                          IsThumbToolTipEnabled="False"
                          Value="{x:Bind NoteListViewModel.ToDouble(NoteListViewModel.PreviewTileRatio), Mode=TwoWay, BindBack=PreviewTileRatioBindBack}" />
                  <Grid Grid.Row="1">
                    <TextBlock Text="Short"
                               HorizontalAlignment="Left"
                               TextAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="Sqare"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="Tall"
                               HorizontalAlignment="Right"
                               TextAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                  </Grid>
                </Grid>
              </templates:MenuFlyoutElementContainer>
            </MenuFlyoutSubItem>
          </MenuFlyout>

        </templates:SubtleIconButton.Flyout>
      </templates:SubtleIconButton>
      <!--#endregion-->
    </Grid>

    <GridView x:Name="BookmarksPage_NotesListGridView"
              Grid.Row="1"
              ItemsSource="{x:Bind NoteListViewModel.NoteViewModels, Mode=OneWay}"
              SelectionMode="None"
              AllowFocusOnInteraction="False"
              ScrollViewer.VerticalScrollMode="Enabled"
              ScrollViewer.VerticalScrollBarVisibility="Visible" />
  </Grid>
</Page>
