<?xml version="1.0" encoding="utf-8"?>
<ContentDialog x:Class="MyNotes.Views.Dialogs.AddUserNavigationDialog"
               x:Uid="AddUserNavigationDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:local="using:MyNotes.Views.Dialogs"
               xmlns:templates="using:MyNotes.Templates"
               xmlns:helpers="using:MyNotes.Helpers"
               Style="{StaticResource DefaultContentDialogStyle}"
               DefaultButton="Primary"
               PrimaryButtonText="Add"
               CloseButtonText="Cancel"
               IsPrimaryButtonEnabled="{x:Bind helpers:StringHelper.IsFilled(ViewModel.Title), Mode=OneWay}"
               PrimaryButtonCommand="{x:Bind ViewModel.AddNodeCommand}">

  <ContentDialog.Title>
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="New node" />
      <TextBlock Text=" (custom)" />
    </StackPanel>
  </ContentDialog.Title>
  
  <Grid ColumnSpacing="6">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <templates:SubtleIconButton x:Name="AddUserNodeDialog_IconButton">
      <templates:SubtleIconButton.Icon>
        <ImageIcon Source="{x:Bind AddUserNodeDialog_IconPicker.IconImage, Mode=OneWay, FallbackValue='System_Board'}" />
      </templates:SubtleIconButton.Icon>
      <templates:SubtleIconButton.Flyout>
        <Flyout Placement="Bottom">
          <templates:IconPicker x:Name="AddUserNodeDialog_IconPicker"
                                Icon="{x:Bind ViewModel.Icon, Mode=TwoWay}"
                                DecodePixelWidth="40"
                                DecodePixelHeight="40" />
        </Flyout>
      </templates:SubtleIconButton.Flyout>
    </templates:SubtleIconButton>

    <TextBox x:Name="AddUserNodeDialog_TitleTextBox"
             Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             VerticalAlignment="Center"
             Grid.Column="1" />
  </Grid>
</ContentDialog>
