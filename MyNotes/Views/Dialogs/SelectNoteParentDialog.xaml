<?xml version="1.0" encoding="utf-8"?>
<ContentDialog x:Class="MyNotes.Views.Dialogs.SelectNoteParentDialog"
               x:Uid="SelectNoteParentDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:navigationvm="using:MyNotes.ViewModels.Navigations.Items"
               Style="{StaticResource DefaultContentDialogStyle}"
               DefaultButton="Primary"
               PrimaryButtonText="Set"
               CloseButtonText="Cancel"
               IsPrimaryButtonEnabled="{x:Bind IsNotNull(ViewModel.SelectedNavigationViewModel), Mode=OneWay}"
               Title="Select navigation.">

  <StackPanel>
    <ListView ItemsSource="{x:Bind ViewModel.TargetNavigationViewModels}"
              SelectedItem="{x:Bind ViewModel.SelectedNavigationViewModel, Mode=TwoWay}">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="navigationvm:UserListNavigationViewModel">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Viewbox Grid.Column="0"
                     Width="16"
                     Height="16">
              <ImageIcon Source="{x:Bind IconImage, Mode=OneWay}" />
            </Viewbox>
            <TextBlock Grid.Column="1"
                       Text="{x:Bind Navigation.Title, Mode=OneWay}" />
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </StackPanel>
</ContentDialog>