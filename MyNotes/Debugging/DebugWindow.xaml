<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="MyNotes.Debugging.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:MyNotes.Debugging"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DebugWindow">

  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <StackPanel Spacing="8"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
    <Button x:Name="DebugWindow_SeparatorButton"
            Content="Separator"
            Click="DebugWindow_SeparatorButton_Click" />
    <MenuFlyoutSeparator />
    <Button x:Name="DebugWindow_DebugButton"
            Content="Debug"
            Click="DebugWindow_DebugButton_Click" />

    <MenuFlyoutSeparator />
    <Button x:Name="DebugWindow_GCButton"
            Content="GC"
            Click="DebugWindow_GCButton_Click" />
    <MenuFlyoutSeparator />
    <Button x:Name="DebugWindow_NewNoteButton"
            Content="New note"
            Click="DebugWindow_NewNoteButton_Click" />
    <Button x:Name="DebugWindow_BlankWindowButton"
            Content="Blank window"
            Click="DebugWindow_BlankWindowButton_Click" />

    <MenuFlyoutSeparator />
    <MenuFlyoutSeparator />
    <Button x:Name="DebugWindow_ClearDatabaseButton"
            Content="Clear DB"
            Click="DebugWindow_ClearDatabaseButton_Click" />
    <Button x:Name="DebugWindow_CreateDatabaseButton"
            Content="Create DB"
            Click="DebugWindow_CreateDatabaseButton_Click" />
  </StackPanel>
</Window>
