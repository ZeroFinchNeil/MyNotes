<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary x:Class="MyNotes.Resources.NoteResources"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:MyNotes.Resources"
                    xmlns:converters="using:MyNotes.Common.Converters"
                    xmlns:muxm="using:Microsoft.UI.Xaml.Media"
                    xmlns:mxi="using:Microsoft.Xaml.Interactivity">
  <converters:EnumToIntConverter x:Key="BackdropKindToIntConverter"
                                 xmlns:enums="using:MyNotes.Application.Contracts.Notes.Models"
                                 EnumType="enums:BackdropKind" />
  
  <converters:EnumToIntConverter x:Key="StretchToIntConverter"
                                 EnumType="muxm:Stretch" />

  <converters:EnumToIntConverter x:Key="AlignmentXToIntConverter"
                                 EnumType="muxm:AlignmentX" />

  <converters:EnumToIntConverter x:Key="AlignmentYToIntConverter"
                                 EnumType="muxm:AlignmentY" />
</ResourceDictionary>
