  </Style>

  <Style x:Key="EmphasisAccentMenuFlyoutItemStyle"
         TargetType="MenuFlyoutItem"
         BasedOn="{StaticResource EmphasisMenuFlyoutItemStyle}">
    <Setter Property="Foreground"
